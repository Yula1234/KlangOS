packed struct IdtEntry {
    offset_low:  u16,
    selector:    u16,
    ist:         u8,
    type_attr:   u8,
    offset_mid:  u16,
    offset_high: u32,
    zero:        u32
}

packed struct IdtPointer {
    limit: u16,
    base:  u64
}

var g_idt: [256]IdtEntry;
var g_idt_ptr: IdtPointer;

proc idt_set_gate(num: u8, handler: u64, selector: u16, flags: u8) -> void {
    var entry: IdtEntry* = &g_idt[num];

    entry.offset_low  = cast(u16, handler & 0xFFFF);
    entry.selector    = selector;
    entry.ist         = 0;
    entry.type_attr   = flags;
    entry.offset_mid  = cast(u16, (handler >> 16) & 0xFFFF);
    entry.offset_high = cast(u32, (handler >> 32) & 0xFFFFFFFF);
    entry.zero        = 0;

    return;
}

proc idt_init(stub_table: u64*) -> void {
    var i: u64 = 0;

    while (i < 256) {
        idt_set_gate(cast(u8, i), stub_table[i], 0x08, 0x8E);
        i += 1;
    }

    g_idt_ptr.limit = cast(u16, (256 * 16) - 1);
    g_idt_ptr.base  = cast(u64, &g_idt[0]);

    asm "lea rax, [rel g_idt_ptr]";
    asm "lidt [rax]";

    return;
}