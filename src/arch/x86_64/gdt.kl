const GDT_NULL_DESC:        u64 = 0x0000000000000000;
const GDT_KERNEL_CODE_DESC: u64 = 0x00209A0000000000;
const GDT_KERNEL_DATA_DESC: u64 = 0x0000920000000000;
const GDT_USER_DATA_DESC:   u64 = 0x0000F20000000000;
const GDT_USER_CODE_DESC:   u64 = 0x0020FA0000000000;

const GDT_KERNEL_CODE_SEL:  u16 = 0x0008;
const GDT_KERNEL_DATA_SEL:  u16 = 0x0010;
const GDT_USER_DATA_SEL:    u16 = 0x0018;
const GDT_USER_CODE_SEL:    u16 = 0x0020;
const GDT_TSS_SEL:          u16 = 0x0028;

const GDT_ENTRIES_COUNT:    u64 = 7;
const DF_STACK_SIZE:        u64 = 4096;
const TSS_TYPE_AVAILABLE:   u64 = 0x89;

packed struct TSS {
    reserved0:  u32 = 0,
    rsp0:       u64 = 0,
    rsp1:       u64 = 0,
    rsp2:       u64 = 0,
    reserved1:  u64 = 0,
    ist1:       u64 = 0,
    ist2:       u64 = 0,
    ist3:       u64 = 0,
    ist4:       u64 = 0,
    ist5:       u64 = 0,
    ist6:       u64 = 0,
    ist7:       u64 = 0,
    reserved2:  u64 = 0,
    reserved3:  u16 = 0,
    iomap_base: u16 = 104
}

packed struct GdtPointer {
    limit: u16,
    base:  u64
}

var g_gdt:      [7]u64;
var g_tss:      TSS;
var g_gdt_ptr:  GdtPointer;
var g_df_stack: [4096]u8;

@inline proc gdt_create_tss_low(base: u64, limit: u64) -> u64 {
    var limit_low:  u64 = limit & 0xFFFF;
    var base_low:   u64 = (base & 0x00FFFFFF) << 16;
    var type_flags: u64 = TSS_TYPE_AVAILABLE << 40;
    var base_mid:   u64 = (base & 0xFF000000) << 32;

    return limit_low | base_low | type_flags | base_mid;
}

@inline proc gdt_create_tss_high(base: u64) -> u64 {
    return (base >> 32) & 0xFFFFFFFF;
}

@inline proc gdt_load(ptr: GdtPointer*) -> void {
    asm ("lgdt [rdi]" : in(ptr) "rdi" : clobber "memory");

    return;
}

@inline proc gdt_reload_segments(data_sel: u16) -> void {
    asm ("mov ds, ax\n    mov es, ax\n    mov fs, ax\n    mov gs, ax\n    mov ss, ax" : in(data_sel) "ax" : clobber "memory");

    return;
}

@inline proc gdt_load_tss(tss_sel: u16) -> void {
    asm ("ltr ax" : in(tss_sel) "ax" : clobber "memory");

    return;
}

proc gdt_init(kernel_stack_top: u64) -> void {
    var df_stack_top: u64 = (cast(u64, &g_df_stack[0]) + DF_STACK_SIZE) & ~15;

    g_tss = TSS {
        rsp0:       kernel_stack_top,
        ist1:       df_stack_top,
        iomap_base: cast(u16, sizeof(TSS))
    };

    var tss_base:  u64 = cast(u64, &g_tss);
    var tss_limit: u64 = sizeof(TSS) - 1;

    g_gdt[0] = GDT_NULL_DESC;
    g_gdt[1] = GDT_KERNEL_CODE_DESC;
    g_gdt[2] = GDT_KERNEL_DATA_DESC;
    g_gdt[3] = GDT_USER_DATA_DESC;
    g_gdt[4] = GDT_USER_CODE_DESC;
    g_gdt[5] = gdt_create_tss_low(tss_base, tss_limit);
    g_gdt[6] = gdt_create_tss_high(tss_base);

    g_gdt_ptr = GdtPointer {
        limit: cast(u16, (GDT_ENTRIES_COUNT * sizeof(u64)) - 1),
        base:  cast(u64, &g_gdt[0])
    };

    gdt_load(&g_gdt_ptr);
    gdt_reload_segments(GDT_KERNEL_DATA_SEL);
    gdt_load_tss(GDT_TSS_SEL);

    return;
}