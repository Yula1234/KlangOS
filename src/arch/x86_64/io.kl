const PORT_PIC1_CMD:    u16 = 0x0020;
const PORT_PIC1_DATA:   u16 = 0x0021;
const PORT_PIC2_CMD:    u16 = 0x00A0;
const PORT_PIC2_DATA:   u16 = 0x00A1;

const PORT_PIT_CH0:     u16 = 0x0040;
const PORT_PIT_CH1:     u16 = 0x0041;
const PORT_PIT_CH2:     u16 = 0x0042;
const PORT_PIT_CMD:     u16 = 0x0043;

const PORT_PS2_DATA:    u16 = 0x0060;
const PORT_PS2_STATUS:  u16 = 0x0064;
const PORT_PS2_CMD:     u16 = 0x0064;

const PORT_RTC_INDEX:   u16 = 0x0070;
const PORT_RTC_DATA:    u16 = 0x0071;

const PORT_POST_CHECK:  u16 = 0x0080;

const PORT_COM1:        u16 = 0x03F8;
const PORT_COM2:        u16 = 0x02F8;

proc io_outb(port: u16, val: u8) -> void {
    asm ("out dx, al" : in(port) "dx", in(val) "al");

    return;
}

proc io_inb(port: u16) -> u8 {
    return asm ("in al, dx" : in(port) "dx" : out "al") -> u8;
}

proc io_outw(port: u16, val: u16) -> void {
    asm ("out dx, ax" : in(port) "dx", in(val) "ax");

    return;
}

proc io_inw(port: u16) -> u16 {
    return asm ("in ax, dx" : in(port) "dx" : out "ax") -> u16;
}

proc io_outd(port: u16, val: u32) -> void {
    asm ("out dx, eax" : in(port) "dx", in(val) "eax");

    return;
}

proc io_ind(port: u16) -> u32 {
    return asm ("in eax, dx" : in(port) "dx" : out "eax") -> u32;
}

proc io_wait() -> void {
    asm "out 0x80, al";

    return;
}

proc io_insb(port: u16, buffer: u8*, count: u64) -> void {
    asm ("cld\n    rep insb" : in(port) "dx", in(buffer) "rdi", in(count) "rcx" : clobber "memory");

    return;
}

proc io_outsb(port: u16, buffer: u8*, count: u64) -> void {
    asm ("cld\n    rep outsb" : in(port) "dx", in(buffer) "rsi", in(count) "rcx" : clobber "memory");

    return;
}

proc io_insw(port: u16, buffer: u16*, count: u64) -> void {
    asm "mov rcx, rdx";
    asm "mov dx, di";
    asm "mov rdi, rsi";
    asm "cld";
    asm "rep insw";

    return;
}

proc io_outsw(port: u16, buffer: u16*, count: u64) -> void {
    asm "mov rcx, rdx";
    asm "mov dx, di";
    asm "cld";
    asm "rep outsw";

    return;
}

proc io_insd(port: u16, buffer: u32*, count: u64) -> void {
    asm "mov rcx, rdx";
    asm "mov dx, di";
    asm "mov rdi, rsi";
    asm "cld";
    asm "rep insd";

    return;
}

proc io_outsd(port: u16, buffer: u32*, count: u64) -> void {
    asm "mov rcx, rdx";
    asm "mov dx, di";
    asm "cld";
    asm "rep outsd";

    return;
}

proc io_set_mask_8(port: u16, mask: u8) -> void {
    var current: u8 = io_inb(port);
    io_outb(port, current | mask);

    return;
}

proc io_clear_mask_8(port: u16, mask: u8) -> void {
    var current: u8 = io_inb(port);
    io_outb(port, current & ~mask);

    return;
}

proc io_test_bit_8(port: u16, bit: u8) -> bool {
    var current: u8 = io_inb(port);
    var mask: u8 = cast(u8, 1) << bit;

    return (current & mask) != 0;
}