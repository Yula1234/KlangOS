@inline proc cpu_save_flags_and_cli() -> u64 {
    return asm ("pushfq\n    pop rax\n    cli" : out "rax") -> u64;
}


@inline proc cpu_restore_flags(flags: u64) -> void {
    asm ("push rax\n    popfq" : in(flags) "rax");

    return;
}


@inline proc cpu_cli() -> void {
    asm "cli";
    return;
}


@inline proc cpu_sti() -> void {
    asm "sti";
    return;
}


@inline proc cpu_pause() -> void {
    asm "pause";
    return;
}


@inline proc cpu_hlt() -> void {
    asm "hlt";
    return;
}


proc cpu_rdtsc() -> u64 {
    var low:  u32;
    var high: u32;

    asm ("rdtsc" : out(low) "eax", out(high) "edx");

    return (cast(u64, high) << 32) | cast(u64, low);
}

@inline proc cpu_sti_and_hlt() -> void {
    asm "sti\n    hlt";

    return;
}