import "vga.kl";
import "multiboot.kl";
import "gdt.kl";
import "idt.kl";
import "isr.kl";
import "pmm.kl";
import "vmm.kl";

proc kmain(magic: u32, mbi: MultibootInfo*) -> void {
    vga_clear(0x1F);

    vga_print("==================================================", 0x1E, 1, 14);
    vga_print("                Welcome to KlangOS                ", 0x1F, 2, 14);
    vga_print("==================================================", 0x1E, 3, 14);

    asm "extern stack_top";
    var kernel_stack_top: u64 = cast(u64, asm "lea rax, [rel stack_top]" -> u64);
    gdt_init(kernel_stack_top);
    vga_print("[OK] GDT & TSS Initialized", 0x1A, 5, 4);

    asm "extern isr_stub_table";
    var isr_table: u64* = cast(u64*, asm "lea rax, [rel isr_stub_table]" -> u64);
    idt_init(isr_table);
    vga_print("[OK] IDT Initialized", 0x1A, 6, 4);

    asm "extern _kernel_end";
    var kernel_end: u64 = cast(u64, asm "lea rax, [rel _kernel_end]" -> u64);
    pmm_init(mbi, kernel_end);
    vga_print("[OK] PMM Bitmap Initialized", 0x1A, 7, 4);

    var kernel_pml4: u64* = vmm_init(kernel_end);
    vga_print("[OK] VMM 4-Level Paging Initialized (CR3 Loaded)", 0x1A, 8, 4);

    var test_phys_frame: u64 = pmm_alloc_page();
    var test_virt_addr: u64 = 0xCAFE0000;

    vmm_map_page(kernel_pml4, test_virt_addr, test_phys_frame, 3);

    var mapped_ptr: u64* = cast(u64*, test_virt_addr);
    mapped_ptr[0] = 0x12345678DEADBEEF;

    var read_back_val: u64 = mapped_ptr[0];
    var resolved_phys: u64 = vmm_virt_to_phys(kernel_pml4, test_virt_addr);

    vga_print("Virtual  Address: ", 0x1F, 11, 4);
    vga_print_hex(test_virt_addr, 0x1E, 11, 23);

    vga_print("Mapped Physical : ", 0x1F, 12, 4);
    vga_print_hex(resolved_phys, 0x1E, 12, 23);

    vga_print("Read Back Value : ", 0x1F, 13, 4);
    vga_print_hex(read_back_val, 0x1E, 13, 23);

    if (read_back_val == 0x12345678DEADBEEF) {
        vga_print("[SUCCESS] Dynamic 4-Level Paging Verification Passed!", 0x1A, 16, 4);
    } else {
        vga_print("[FAILURE] Memory R/W Integrity Error!", 0x4F, 16, 4);
    }

    vga_print("Kernel VMM is operational!", 0x1E, 19, 4);

    while (1) {
        asm "hlt";
    }

    return;
}