import "arch/x86_64/apic.kl";
import "arch/x86_64/gdt.kl";
import "arch/x86_64/idt.kl";
import "arch/x86_64/isr.kl";
import "arch/x86_64/io.kl";

import "drivers/keyboard.kl";
import "drivers/vga.kl";

import "sched/thread.kl";
import "sched/sched.kl";

import "boot/multiboot.kl";

import "mm/pmm.kl";
import "mm/vmm.kl";
import "mm/heap.kl";

@extern var stack_top: u8;
@extern var isr_stub_table: [256]u64;
@extern var _kernel_end: u8;

proc task_worker_a(arg: u64) -> void {
    var counter: u64 = 0;

    vga_print("Task A (Counter) : ", 0x1F, 21, 4);

    while (1) {
        counter = counter + 1;
        vga_print_dec(counter, 0x1E, 21, 23);
        thread_sleep(10);
    }

    return;
}


proc task_worker_b(arg: u64) -> void {
    var step: u64    = 0;
    var anim: []char = "|/-\\";

    vga_print("Task B (Spinner) : [ ]", 0x1F, 22, 4);

    while (1) {
        var char_idx: u64 = step & 3;

        vga_print(anim[char_idx..(char_idx + 1)], 0x1A, 22, 24);

        step = step + 1;
        thread_sleep(5);
    }

    return;
}


proc kmain(magic: u32, mbi: MultibootInfo*) -> void {
    vga_clear(0x1F);

    vga_print("==================================================", 0x1E, 1, 14);
    vga_print("                Welcome to KlangOS                ", 0x1F, 2, 14);
    vga_print("==================================================", 0x1E, 3, 14);

    var kernel_stack_top: u64 = cast(u64, &stack_top);
    gdt_init(kernel_stack_top);
    vga_print("[OK] GDT & TSS Initialized", 0x1A, 5, 4);

    idt_init(&isr_stub_table[0]);
    vga_print("[OK] IDT (256 Gates) Initialized", 0x1A, 6, 4);

    var kernel_end: u64 = cast(u64, &_kernel_end);
    pmm_init(mbi, kernel_end);
    vga_print("[OK] PMM Physical Allocator Initialized", 0x1A, 7, 4);

    var kernel_pml4: u64* = vmm_init(kernel_end);
    vga_print("[OK] VMM 4-Level Paging Initialized", 0x1A, 8, 4);

    heap_init(4);
    vga_print("[OK] Kernel Heap Initialized (0x10000000)", 0x1A, 10, 4);

    var ptr_a: u8* = kalloc(64);
    var ptr_b: u8* = kalloc(128);
    var ptr_c: u8* = kalloc(256);

    vga_print("Alloc A (64B)  : ", 0x1F, 11, 4);
    vga_print_hex(cast(u64, ptr_a), 0x1E, 11, 22);

    vga_print("Alloc B (128B) : ", 0x1F, 12, 4);
    vga_print_hex(cast(u64, ptr_b), 0x1E, 12, 22);

    vga_print("Alloc C (256B) : ", 0x1F, 13, 4);
    vga_print_hex(cast(u64, ptr_c), 0x1E, 13, 22);

    kfree(ptr_b);

    var ptr_d: u8* = kalloc(64);

    vga_print("Reuse B (64B)  : ", 0x1F, 15, 4);
    vga_print_hex(cast(u64, ptr_d), 0x1E, 15, 22);

    var ptr_large: u8* = kalloc(32768);

    vga_print("Dynamic Expand : ", 0x1F, 16, 4);
    vga_print_hex(cast(u64, ptr_large), 0x1E, 16, 22);

    if (cast(u64, ptr_d) == cast(u64, ptr_b)) {
        vga_print("[SUCCESS] Block Splitting & Reuse Verified!", 0x1A, 18, 4);
    }

    if (cast(u64, ptr_large) > 0x10000000) {
        vga_print("[SUCCESS] On-Demand Heap Expansion Verified!", 0x1A, 19, 4);
    }

    apic_init();
    vga_print("[OK] APIC Subsystem (LAPIC & I/O APIC) Online", 0x1A, 20, 4);

    var bsp_id: u8 = cast(u8, lapic_get_id());

    ioapic_route_isa_irq(0, 32, bsp_id);
    ioapic_route_isa_irq(2, 32, bsp_id);

    lapic_timer_init(32, 50000, true);

    keyboard_init();
    ioapic_route_isa_irq(1, 33, bsp_id);

    sched_init();

    thread_create(cast(u64, task_worker_a), 0);
    thread_create(cast(u64, task_worker_b), 0);

    asm "sti";

    vga_print("Interactive CLI  : ", 0x1E, 24, 4);

    var input_col: u64 = 23;

    while (1) {
        var c: char = keyboard_getchar();

        switch (cast(u8, c)) {
            case 8: {
                if (input_col > 23) {
                    input_col = input_col - 1;
                    vga_print_char(cast(char, 32), 0x1F, 24, input_col);
                }
            }

            case 10: {
                while (input_col > 23) {
                    input_col = input_col - 1;
                    vga_print_char(cast(char, 32), 0x1F, 24, input_col);
                }
            }

            default: {
                if (input_col < 78) {
                    vga_print_char(c, 0x1F, 24, input_col);
                    input_col = input_col + 1;
                }
            }
        }
    }

    return;
}