import "io.kl";


var g_kbd_buffer: [128]char;
var g_kbd_head:   u32;
var g_kbd_tail:   u32;
var g_kbd_shift:  bool;
var g_kbd_caps:   bool;


proc keyboard_init() -> void {
    g_kbd_head  = 0;
    g_kbd_tail  = 0;
    g_kbd_shift = false;
    g_kbd_caps  = false;

    return;
}


proc keyboard_push(c: char) -> void {
    if (c == cast(char, 0)) {
        return;
    }

    var next_head: u32 = (g_kbd_head + 1) & 127;

    if (next_head != g_kbd_tail) {
        g_kbd_buffer[g_kbd_head] = c;
        g_kbd_head = next_head;
    }

    return;
}


proc keyboard_has_char() -> bool {
    return g_kbd_head != g_kbd_tail;
}


proc keyboard_getchar() -> char {
    while (!keyboard_has_char()) {
        asm "hlt";
    }

    var c: char = g_kbd_buffer[g_kbd_tail];
    g_kbd_tail = (g_kbd_tail + 1) & 127;

    return c;
}


proc keyboard_translate(scancode: u8) -> char {
    if (scancode > 58) {
        return cast(char, 0);
    }

    if (g_kbd_shift) {
        var map_shift: char* = "\0\x1B!@#$%^&*()_+\x08\tQWERTYUIOP{}\n\0ASDFGHJKL:\x22~\0|ZXCVBNM<>?\0*\0 \0";
        return map_shift[scancode];
    }

    var map_normal: char* = "\0\x1B1234567890-=\x08\tqwertyuiop[]\n\0asdfghjkl;\x27`\0\\zxcvbnm,./\0*\0 \0";
    var c: char = map_normal[scancode];

    if (g_kbd_caps) {
        if (c >= cast(char, 97) && c <= cast(char, 122)) {
            return cast(char, cast(u8, c) - 32);
        }
    }

    return c;
}


proc keyboard_handle_irq() -> void {
    var status: u8 = io_inb(0x64);

    if ((status & 1) == 0) {
        return;
    }

    var scancode: u8 = io_inb(0x60);

    if (scancode == 0x2A || scancode == 0x36) {
        g_kbd_shift = true;
        return;
    }

    if (scancode == 0xAA || scancode == 0xB6) {
        g_kbd_shift = false;
        return;
    }

    if (scancode == 0x3A) {
        g_kbd_caps = !g_kbd_caps;
        return;
    }

    if ((scancode & 0x80) != 0) {
        return;
    }

    var c: char = keyboard_translate(scancode);

    if (c != cast(char, 0)) {
        keyboard_push(c);
    }

    return;
}