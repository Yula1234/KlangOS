import "sync/spinlock.kl";


var g_vga_lock: Spinlock;


proc vga_init() -> void {
    g_vga_lock.init();

    return;
}


proc vga_clear_unlocked(color: u8) -> void {
    var vga: u16*  = cast(u16*, 0x000B8000);
    var blank: u16 = (cast(u16, color) << 8) | 32;
    var i: u64     = 0;

    while (i < 80 * 25) {
        vga[i] = blank;
        i += 1;
    }

    return;
}


proc vga_clear(color: u8) -> void {
    g_vga_lock.acquire_irq();
    vga_clear_unlocked(color);
    g_vga_lock.release_irq();

    return;
}


proc vga_print_unlocked(str: char*, color: u8, line: u64, col: u64) -> void {
    var vga: u16*   = cast(u16*, 0x000B8000);
    var offset: u64 = line * 80 + col;
    var i: u64      = 0;

    while (str[i] != cast(char, 0)) {
        vga[offset + i] = (cast(u16, color) << 8) | cast(u16, cast(u8, str[i]));
        i += 1;
    }

    return;
}


proc vga_print(str: char*, color: u8, line: u64, col: u64) -> void {
    g_vga_lock.acquire_irq();
    vga_print_unlocked(str, color, line, col);
    g_vga_lock.release_irq();

    return;
}


proc vga_print_dec_unlocked(val: u64, color: u8, line: u64, col: u64) -> void {
    if (val == 0) {
        vga_print_unlocked("0", color, line, col);
        return;
    }

    var buf: [24]char;
    var temp: u64 = val;
    var len: u64  = 0;

    while (temp > 0) {
        var rem: u64 = temp % 10;
        buf[len] = cast(char, 48 + rem);
        temp = temp / 10;
        len += 1;
    }

    var start: u64 = 0;
    var end: u64   = len - 1;

    while (start < end) {
        var t: char = buf[start];
        buf[start]  = buf[end];
        buf[end]    = t;
        start += 1;
        end   -= 1;
    }

    buf[len] = cast(char, 0);

    vga_print_unlocked(&buf[0], color, line, col);

    return;
}


proc vga_print_dec(val: u64, color: u8, line: u64, col: u64) -> void {
    g_vga_lock.acquire_irq();
    vga_print_dec_unlocked(val, color, line, col);
    g_vga_lock.release_irq();

    return;
}


proc vga_print_hex_unlocked(val: u64, color: u8, line: u64, col: u64) -> void {
    var hex_digits: char* = "0123456789ABCDEF";
    var buf: [19]char;

    buf[0] = cast(char, 48);
    buf[1] = cast(char, 120);

    var i: u64 = 0;

    while (i < 8) {
        var shift: u64 = (7 - i) * 4;
        var digit: u64 = (val >> shift) & 15;
        buf[2 + i] = hex_digits[digit];
        i += 1;
    }

    buf[10] = cast(char, 0);

    vga_print_unlocked(&buf[0], color, line, col);

    return;
}


proc vga_print_hex(val: u64, color: u8, line: u64, col: u64) -> void {
    g_vga_lock.acquire_irq();
    vga_print_hex_unlocked(val, color, line, col);
    g_vga_lock.release_irq();

    return;
}