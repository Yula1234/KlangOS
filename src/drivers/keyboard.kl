import "arch/x86_64/io.kl";
import "arch/x86_64/cpu.kl";

import "sync/spinlock.kl";

import "lib/str.kl";
import "lib/ring_buffer.kl";

const KBD_BUFFER_SIZE: u64 = 128;

var g_kbd_storage:    [128]char;
var g_kbd_queue:      RingBuffer[char];

var g_kbd_shift:      bool;
var g_kbd_caps:       bool;

var g_kbd_state_lock: Spinlock;

proc keyboard_init() -> void {
    g_kbd_queue.init(&g_kbd_storage[0], KBD_BUFFER_SIZE);

    g_kbd_state_lock.init();

    g_kbd_shift = false;
    g_kbd_caps  = false;

    return;
}

proc keyboard_has_char() -> bool {
    return !g_kbd_queue.is_empty();
}

proc keyboard_getchar() -> char {
    while (1) {
        var (c, ok) = g_kbd_queue.pop();

        if (ok) {
            return c;
        }

        cpu_sti_and_hlt();
    }

    return cast(char, 0);
}

proc keyboard_translate(scancode: u8) -> char {
    if (scancode > 58) {
        return cast(char, 0);
    }

    if (g_kbd_shift) {
        var map_shift: char* = "\0\x1B!@#$%^&*()_+\x08\tQWERTYUIOP{}\n\0ASDFGHJKL:\x22~\0|ZXCVBNM<>?\0*\0 \0";
        return map_shift[scancode];
    }

    var map_normal: char* = "\0\x1B1234567890-=\x08\tqwertyuiop[]\n\0asdfghjkl;\x27`\0\\zxcvbnm,./\0*\0 \0";
    var c: char = map_normal[scancode];

    if (g_kbd_caps) {
        return to_upper(c);
    }

    return c;
}

proc keyboard_handle_irq() -> void {
    var status: u8 = io_inb(0x64);

    if ((status & 1) == 0) {
        return;
    }

    var scancode: u8 = io_inb(0x60);

    g_kbd_state_lock.acquire_irq();
    defer g_kbd_state_lock.release_irq();

    if (scancode == 0x2A || scancode == 0x36) {
        g_kbd_shift = true;
        return;
    }

    if (scancode == 0xAA || scancode == 0xB6) {
        g_kbd_shift = false;
        return;
    }

    if (scancode == 0x3A) {
        g_kbd_caps = !g_kbd_caps;
        return;
    }

    if ((scancode & 0x80) != 0) {
        return;
    }

    var c: char = keyboard_translate(scancode);

    if (c != cast(char, 0)) {
        g_kbd_queue.push(c);
    }

    return;
}