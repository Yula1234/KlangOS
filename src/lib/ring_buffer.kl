import "sync/spinlock.kl";

struct RingBuffer[T] {
    buffer:   T*,
    capacity: u64,
    head:     u64,
    tail:     u64,
    count:    u64,
    lock:     Spinlock,

    proc init(rb: RingBuffer[T]*, storage: T*, capacity: u64) -> void {
        rb.buffer   = storage;
        rb.capacity = capacity;
        rb.head     = 0;
        rb.tail     = 0;
        rb.count    = 0;

        rb.lock.init();

        return;
    }

    proc is_empty(rb: RingBuffer[T]*) -> bool {
        rb.lock.acquire_irq();
        defer rb.lock.release_irq();

        return rb.count == 0;
    }

    proc is_full(rb: RingBuffer[T]*) -> bool {
        rb.lock.acquire_irq();
        defer rb.lock.release_irq();

        return rb.count == rb.capacity;
    }

    proc count(rb: RingBuffer[T]*) -> u64 {
        rb.lock.acquire_irq();
        defer rb.lock.release_irq();

        return rb.count;
    }

    proc clear(rb: RingBuffer[T]*) -> void {
        rb.lock.acquire_irq();
        defer rb.lock.release_irq();

        rb.head  = 0;
        rb.tail  = 0;
        rb.count = 0;

        return;
    }

    proc push(rb: RingBuffer[T]*, item: T) -> bool {
        rb.lock.acquire_irq();
        defer rb.lock.release_irq();

        if (rb.count == rb.capacity) {
            return false;
        }

        rb.buffer[rb.head] = item;
        rb.head  = (rb.head + 1) % rb.capacity;
        rb.count = rb.count + 1;

        return true;
    }

    proc pop(rb: RingBuffer[T]*) -> (T, bool) {
        rb.lock.acquire_irq();
        defer rb.lock.release_irq();

        if (rb.count == 0) {
            return (cast(T, 0), false);
        }

        var item: T = rb.buffer[rb.tail];

        rb.tail  = (rb.tail + 1) % rb.capacity;
        rb.count = rb.count - 1;

        return (item, true);
    }
}