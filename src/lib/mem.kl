proc memset(dst: u8*, val: u8, count: u64) -> u8* {
    asm ("cld\n    rep stosb" : in(dst) "rdi", in(val) "al", in(count) "rcx" : clobber "memory");

    return dst;
}


proc memcpy(dst: u8*, src: u8*, count: u64) -> u8* {
    asm ("cld\n    rep movsb" : in(dst) "rdi", in(src) "rsi", in(count) "rcx" : clobber "memory");

    return dst;
}


proc memmove(dst: u8*, src: u8*, count: u64) -> u8* {
    if (count == 0 || dst == src) {
        return dst;
    }

    var d: u64 = cast(u64, dst);
    var s: u64 = cast(u64, src);

    if (d < s || d >= (s + count)) {
        return memcpy(dst, src, count);
    }

    var i: u64 = count;

    while (i > 0) {
        i = i - 1;
        dst[i] = src[i];
    }

    return dst;
}


proc memcmp(s1: u8*, s2: u8*, count: u64) -> i32 {
    var i: u64 = 0;

    while (i < count) {
        if (s1[i] != s2[i]) {
            if (cast(u32, s1[i]) < cast(u32, s2[i])) {
                return -1;
            }

            return 1;
        }

        i += 1;
    }

    return 0;
}


proc memchr(s: u8*, val: u8, count: u64) -> u8* {
    var i: u64 = 0;

    while (i < count) {
        if (s[i] == val) {
            return &s[i];
        }

        i += 1;
    }

    return cast(u8*, 0);
}


proc memrchr(s: u8*, val: u8, count: u64) -> u8* {
    var i: u64 = count;

    while (i > 0) {
        i = i - 1;

        if (s[i] == val) {
            return &s[i];
        }
    }

    return cast(u8*, 0);
}


proc memset16(dst: u16*, val: u16, count: u64) -> u16* {
    asm "mov ax, si";
    asm "mov rcx, rdx";
    asm "cld";
    asm "rep stosw";

    return dst;
}


proc memset32(dst: u32*, val: u32, count: u64) -> u32* {
    asm "mov eax, esi";
    asm "mov rcx, rdx";
    asm "cld";
    asm "rep stosd";

    return dst;
}


proc memset64(dst: u64*, val: u64, count: u64) -> u64* {
    asm "mov rax, rsi";
    asm "mov rcx, rdx";
    asm "cld";
    asm "rep stosq";

    return dst;
}


proc memcpy16(dst: u16*, src: u16*, count: u64) -> u16* {
    asm "mov rcx, rdx";
    asm "cld";
    asm "rep movsw";

    return dst;
}


proc memcpy32(dst: u32*, src: u32*, count: u64) -> u32* {
    asm "mov rcx, rdx";
    asm "cld";
    asm "rep movsd";

    return dst;
}


proc memcpy64(dst: u64*, src: u64*, count: u64) -> u64* {
    asm "mov rcx, rdx";
    asm "cld";
    asm "rep movsq";

    return dst;
}


proc memzero(dst: u8*, count: u64) -> void {
    memset(dst, cast(u8, 0), count);

    return;
}


proc memzero_page(page_ptr: u64*) -> void {
    var zero:  u64 = 0;
    var words: u64 = 512;

    asm ("cld\n    rep stosq" : in(page_ptr) "rdi", in(zero) "rax", in(words) "rcx" : clobber "memory");

    return;
}


proc mem_is_zero(src: u8*, count: u64) -> bool {
    var i: u64 = 0;

    while (i < count) {
        if (src[i] != cast(u8, 0)) {
            return false;
        }

        i += 1;
    }

    return true;
}


proc mem_count(src: u8*, val: u8, count: u64) -> u64 {
    var total: u64 = 0;
    var i: u64     = 0;

    while (i < count) {
        if (src[i] == val) {
            total = total + 1;
        }

        i += 1;
    }

    return total;
}


proc mem_swap(a: u8*, b: u8*, size: u64) -> void {
    var i: u64 = 0;

    while (i < size) {
        var tmp: u8 = a[i];
        
        a[i]        = b[i];
        b[i]        = tmp;

        i += 1;
    }

    return;
}


proc mem_align_up(addr: u64, align: u64) -> u64 {
    var mask: u64 = align - 1;

    return (addr + mask) & ~mask;
}


proc mem_align_down(addr: u64, align: u64) -> u64 {
    var mask: u64 = align - 1;

    return addr & ~mask;
}


proc mem_is_aligned(addr: u64, align: u64) -> bool {
    var mask: u64 = align - 1;

    return (addr & mask) == 0;
}