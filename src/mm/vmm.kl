import "boot/multiboot.kl";

import "sync/spinlock.kl";

import "lib/mem.kl";

import "pmm.kl";

const HHDM_OFFSET: u64 = 0xFFFF800000000000;

type     VirtAddr = u64;
type     PageTable = u64*;

var g_kernel_pml4: PageTable;
var g_vmm_lock:    Spinlock;


@inline proc phys_to_virt(phys: PhysAddr) -> VirtAddr {
    return cast(u64, phys) + HHDM_OFFSET;
}


@inline proc virt_to_phys(virt: VirtAddr) -> PhysAddr {
    return cast(PhysAddr, virt - HHDM_OFFSET);
}


proc vmm_invlpg(virt_addr: VirtAddr) -> void {
    asm "invlpg [rdi]";

    return;
}


proc vmm_set_cr3(pml4_phys: PhysAddr) -> void {
    asm ("mov cr3, rax" : in(pml4_phys) "rax");

    return;
}


proc vmm_get_cr3() -> PhysAddr {
    return asm ("mov rax, cr3" : out "rax") -> PhysAddr;
}


proc vmm_get_or_create_next_table(current_table: PageTable, index: u64, flags: u64, create_if_missing: u64) -> PageTable {
    var entry: u64 = current_table[index];

    if ((entry & 1) != 0) {
        if ((flags & 4) != 0) {
            current_table[index] = entry | 4;
        }

        var next_phys: PhysAddr = cast(PhysAddr, entry & 0x000FFFFFFFFFF000);

        return cast(PageTable, phys_to_virt(next_phys));
    }

    if (create_if_missing == 0) {
        return cast(PageTable, 0);
    }

    var (new_table_phys, ok) = pmm_alloc_page();

    if (!ok) {
        return cast(PageTable, 0);
    }

    var new_table_ptr: PageTable = cast(PageTable, phys_to_virt(new_table_phys));

    memzero_page(new_table_ptr);

    var entry_flags: u64 = 1 | 2;

    if ((flags & 4) != 0) {
        entry_flags = entry_flags | 4;
    }

    current_table[index] = (cast(u64, new_table_phys) & 0x000FFFFFFFFFF000) | entry_flags;

    return new_table_ptr;
}


proc vmm_map_page_unlocked(pml4: PageTable, virt_addr: VirtAddr, phys_addr: PhysAddr, flags: u64) -> u64 {
    var aligned_virt: VirtAddr = virt_addr & 0xFFFFFFFFFFFFF000;
    var aligned_phys: u64      = cast(u64, phys_addr) & 0x000FFFFFFFFFF000;

    var pml4_idx: u64 = (aligned_virt >> 39) & 511;
    var pdpt_idx: u64 = (aligned_virt >> 30) & 511;
    var pd_idx: u64   = (aligned_virt >> 21) & 511;
    var pt_idx: u64   = (aligned_virt >> 12) & 511;

    var pdpt: PageTable = vmm_get_or_create_next_table(pml4, pml4_idx, flags, 1);

    if (cast(u64, pdpt) == 0) {
        return 0;
    }

    var pd: PageTable = vmm_get_or_create_next_table(pdpt, pdpt_idx, flags, 1);

    if (cast(u64, pd) == 0) {
        return 0;
    }

    var pt: PageTable = vmm_get_or_create_next_table(pd, pd_idx, flags, 1);

    if (cast(u64, pt) == 0) {
        return 0;
    }

    pt[pt_idx] = aligned_phys | (flags & 4095);

    vmm_invlpg(aligned_virt);

    return 1;
}


proc vmm_map_page(pml4: PageTable, virt_addr: VirtAddr, phys_addr: PhysAddr, flags: u64) -> u64 {
    g_vmm_lock.acquire_irq();
    defer g_vmm_lock.release_irq();

    return vmm_map_page_unlocked(pml4, virt_addr, phys_addr, flags);
}


proc vmm_unmap_page_unlocked(pml4: PageTable, virt_addr: VirtAddr) -> void {
    var aligned_virt: VirtAddr = virt_addr & 0xFFFFFFFFFFFFF000;

    var pml4_idx: u64 = (aligned_virt >> 39) & 511;
    var pdpt_idx: u64 = (aligned_virt >> 30) & 511;
    var pd_idx: u64   = (aligned_virt >> 21) & 511;
    var pt_idx: u64   = (aligned_virt >> 12) & 511;

    var pdpt: PageTable = vmm_get_or_create_next_table(pml4, pml4_idx, 0, 0);

    if (cast(u64, pdpt) == 0) {
        return;
    }

    var pd: PageTable = vmm_get_or_create_next_table(pdpt, pdpt_idx, 0, 0);

    if (cast(u64, pd) == 0) {
        return;
    }

    var pt: PageTable = vmm_get_or_create_next_table(pd, pd_idx, 0, 0);

    if (cast(u64, pt) == 0) {
        return;
    }

    pt[pt_idx] = 0;

    vmm_invlpg(aligned_virt);

    return;
}


proc vmm_unmap_page(pml4: PageTable, virt_addr: VirtAddr) -> void {
    g_vmm_lock.acquire_irq();
    defer g_vmm_lock.release_irq();

    vmm_unmap_page_unlocked(pml4, virt_addr);

    return;
}


proc vmm_virt_to_phys(pml4: PageTable, virt_addr: VirtAddr) -> (PhysAddr, bool) {
    if (virt_addr >= HHDM_OFFSET && virt_addr < (HHDM_OFFSET + 0x100000000)) {
        return (virt_to_phys(virt_addr), true);
    }

    var aligned_virt: VirtAddr = virt_addr & 0xFFFFFFFFFFFFF000;
    var page_offset: u64       = virt_addr & 4095;

    var pml4_idx: u64 = (aligned_virt >> 39) & 511;
    var pdpt_idx: u64 = (aligned_virt >> 30) & 511;
    var pd_idx: u64   = (aligned_virt >> 21) & 511;
    var pt_idx: u64   = (aligned_virt >> 12) & 511;

    g_vmm_lock.acquire_irq();
    defer g_vmm_lock.release_irq();

    var pdpt: PageTable = vmm_get_or_create_next_table(pml4, pml4_idx, 0, 0);

    if (cast(u64, pdpt) == 0) {
        return (cast(PhysAddr, 0), false);
    }

    var pd: PageTable = vmm_get_or_create_next_table(pdpt, pdpt_idx, 0, 0);

    if (cast(u64, pd) == 0) {
        return (cast(PhysAddr, 0), false);
    }

    var pt: PageTable = vmm_get_or_create_next_table(pd, pd_idx, 0, 0);

    if (cast(u64, pt) == 0) {
        return (cast(PhysAddr, 0), false);
    }

    var entry: u64 = pt[pt_idx];

    if ((entry & 1) == 0) {
        return (cast(PhysAddr, 0), false);
    }

    return (cast(PhysAddr, (entry & 0x000FFFFFFFFFF000) | page_offset), true);
}


proc vmm_map_range(pml4: PageTable, virt_start: VirtAddr, phys_start: PhysAddr, size: u64, flags: u64) -> u64 {
    g_vmm_lock.acquire_irq();
    defer g_vmm_lock.release_irq();

    var offset: u64 = 0;

    while (offset < size) {
        var cur_virt: VirtAddr = virt_start + offset;
        var cur_phys: PhysAddr = cast(PhysAddr, cast(u64, phys_start) + offset);

        var status: u64 = vmm_map_page_unlocked(pml4, cur_virt, cur_phys, flags);

        if (status == 0) {
            return 0;
        }

        offset = offset + 4096;
    }

    return 1;
}


proc vmm_init(kernel_end: VirtAddr) -> PageTable {
    g_vmm_lock.init();

    var (pml4_phys, ok) = pmm_alloc_page();

    if (!ok) {
        return cast(PageTable, 0);
    }

    var pml4_ptr: PageTable = cast(PageTable, phys_to_virt(pml4_phys));

    memzero_page(pml4_ptr);

    var boot_cr3: PhysAddr   = vmm_get_cr3();
    var boot_pml4: PageTable = cast(PageTable, phys_to_virt(boot_cr3));

    pml4_ptr[0]   = boot_pml4[0];
    pml4_ptr[256] = boot_pml4[256];

    vmm_set_cr3(pml4_phys);

    g_kernel_pml4 = pml4_ptr;

    return pml4_ptr;
}

