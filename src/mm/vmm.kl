import "boot/multiboot.kl";

import "sync/spinlock.kl";

import "lib/mem.kl";

import "pmm.kl";

const HHDM_OFFSET:             u64 = 0xFFFF800000000000;
const HHDM_SIZE:               u64 = 0x0000000100000000;

const USER_SPACE_MIN_ADDR:     u64 = 0x0000000000010000;
const USER_SPACE_MAX_ADDR:     u64 = 0x00007FFFFFFFFFFF;

const VMM_PAGE_SIZE:           u64 = 4096;
const VMM_PAGE_MASK:           u64 = 4095;
const VMM_PAGE_ALIGN_MASK:     u64 = 0xFFFFFFFFFFFFF000;
const VMM_PHYS_ADDR_MASK:      u64 = 0x000FFFFFFFFFF000;

const VMM_ENTRY_MASK:          u64 = 511;
const VMM_ENTRIES_PER_TABLE:   u64 = 512;
const VMM_USER_PML4_ENTRIES:   u64 = 256;

const VMM_PML4_SHIFT:          u64 = 39;
const VMM_PDPT_SHIFT:          u64 = 30;
const VMM_PD_SHIFT:            u64 = 21;
const VMM_PT_SHIFT:            u64 = 12;

const PTE_PRESENT:             u64 = 1;
const PTE_WRITABLE:            u64 = 2;
const PTE_USER:                u64 = 4;

type VirtAddr  = u64;
type PageTable = u64*;

struct VmmState {
    pml4:      PageTable,
    pml4_phys: PhysAddr,

    proc get_or_create_table(s: VmmState*, current_table: PageTable, index: u64, flags: u64, create_if_missing: bool) -> PageTable {
        var entry: u64 = current_table[index];

        if ((entry & PTE_PRESENT) != 0) {
            if ((flags & PTE_USER) != 0) {
                current_table[index] = entry | PTE_USER;
            }

            var next_phys: PhysAddr = cast(PhysAddr, entry & VMM_PHYS_ADDR_MASK);

            return cast(PageTable, phys_to_virt(next_phys));
        }

        if (!create_if_missing) {
            return cast(PageTable, 0);
        }

        var (new_table_phys, ok) = pmm_alloc_page();

        if (!ok) {
            return cast(PageTable, 0);
        }

        var new_table_ptr: PageTable = cast(PageTable, phys_to_virt(new_table_phys));

        memzero_page(new_table_ptr);

        var entry_flags: u64 = PTE_PRESENT | PTE_WRITABLE;

        if ((flags & PTE_USER) != 0) {
            entry_flags = entry_flags | PTE_USER;
        }

        current_table[index] = (cast(u64, new_table_phys) & VMM_PHYS_ADDR_MASK) | entry_flags;

        return new_table_ptr;
    }

    proc map_page(s: VmmState*, virt_addr: VirtAddr, phys_addr: PhysAddr, flags: u64) -> bool {
        var aligned_virt: VirtAddr = virt_addr & VMM_PAGE_ALIGN_MASK;
        var aligned_phys: u64      = cast(u64, phys_addr) & VMM_PHYS_ADDR_MASK;

        var pml4_idx: u64 = (aligned_virt >> VMM_PML4_SHIFT) & VMM_ENTRY_MASK;
        var pdpt_idx: u64 = (aligned_virt >> VMM_PDPT_SHIFT) & VMM_ENTRY_MASK;
        var pd_idx:   u64 = (aligned_virt >> VMM_PD_SHIFT)   & VMM_ENTRY_MASK;
        var pt_idx:   u64 = (aligned_virt >> VMM_PT_SHIFT)   & VMM_ENTRY_MASK;

        var pdpt: PageTable = s.get_or_create_table(s.pml4, pml4_idx, flags, true);

        if (cast(u64, pdpt) == 0) {
            return false;
        }

        var pd: PageTable = s.get_or_create_table(pdpt, pdpt_idx, flags, true);

        if (cast(u64, pd) == 0) {
            return false;
        }

        var pt: PageTable = s.get_or_create_table(pd, pd_idx, flags, true);

        if (cast(u64, pt) == 0) {
            return false;
        }

        pt[pt_idx] = aligned_phys | (flags & VMM_PAGE_MASK);

        vmm_invlpg(aligned_virt);

        return true;
    }

    proc unmap_page(s: VmmState*, virt_addr: VirtAddr) -> void {
        var aligned_virt: VirtAddr = virt_addr & VMM_PAGE_ALIGN_MASK;

        var pml4_idx: u64 = (aligned_virt >> VMM_PML4_SHIFT) & VMM_ENTRY_MASK;
        var pdpt_idx: u64 = (aligned_virt >> VMM_PDPT_SHIFT) & VMM_ENTRY_MASK;
        var pd_idx:   u64 = (aligned_virt >> VMM_PD_SHIFT)   & VMM_ENTRY_MASK;
        var pt_idx:   u64 = (aligned_virt >> VMM_PT_SHIFT)   & VMM_ENTRY_MASK;

        var pdpt: PageTable = s.get_or_create_table(s.pml4, pml4_idx, 0, false);

        if (cast(u64, pdpt) == 0) {
            return;
        }

        var pd: PageTable = s.get_or_create_table(pdpt, pdpt_idx, 0, false);

        if (cast(u64, pd) == 0) {
            return;
        }

        var pt: PageTable = s.get_or_create_table(pd, pd_idx, 0, false);

        if (cast(u64, pt) == 0) {
            return;
        }

        pt[pt_idx] = 0;

        vmm_invlpg(aligned_virt);

        return;
    }

    proc virt_to_phys(s: VmmState*, virt_addr: VirtAddr) -> (PhysAddr, bool) {
        if (virt_addr >= HHDM_OFFSET && virt_addr < (HHDM_OFFSET + HHDM_SIZE)) {
            return (virt_to_phys(virt_addr), true);
        }

        var aligned_virt: VirtAddr = virt_addr & VMM_PAGE_ALIGN_MASK;
        var page_offset:  u64      = virt_addr & VMM_PAGE_MASK;

        var pml4_idx: u64 = (aligned_virt >> VMM_PML4_SHIFT) & VMM_ENTRY_MASK;
        var pdpt_idx: u64 = (aligned_virt >> VMM_PDPT_SHIFT) & VMM_ENTRY_MASK;
        var pd_idx:   u64 = (aligned_virt >> VMM_PD_SHIFT)   & VMM_ENTRY_MASK;
        var pt_idx:   u64 = (aligned_virt >> VMM_PT_SHIFT)   & VMM_ENTRY_MASK;

        var pdpt: PageTable = s.get_or_create_table(s.pml4, pml4_idx, 0, false);

        if (cast(u64, pdpt) == 0) {
            return (cast(PhysAddr, 0), false);
        }

        var pd: PageTable = s.get_or_create_table(pdpt, pdpt_idx, 0, false);

        if (cast(u64, pd) == 0) {
            return (cast(PhysAddr, 0), false);
        }

        var pt: PageTable = s.get_or_create_table(pd, pd_idx, 0, false);

        if (cast(u64, pt) == 0) {
            return (cast(PhysAddr, 0), false);
        }

        var entry: u64 = pt[pt_idx];

        if ((entry & PTE_PRESENT) == 0) {
            return (cast(PhysAddr, 0), false);
        }

        return (cast(PhysAddr, (entry & VMM_PHYS_ADDR_MASK) | page_offset), true);
    }

    proc map_range(s: VmmState*, virt_start: VirtAddr, phys_start: PhysAddr, size: u64, flags: u64) -> bool {
        var offset: u64 = 0;

        while (offset < size) {
            var cur_virt: VirtAddr = virt_start + offset;
            var cur_phys: PhysAddr = cast(PhysAddr, cast(u64, phys_start) + offset);

            if (!s.map_page(cur_virt, cur_phys, flags)) {
                return false;
            }

            offset = offset + VMM_PAGE_SIZE;
        }

        return true;
    }
}

var g_vmm:         Spinlocked[VmmState];
var g_kernel_pml4: PageTable;

@inline proc phys_to_virt(phys: PhysAddr) -> VirtAddr {
    return cast(u64, phys) + HHDM_OFFSET;
}

@inline proc virt_to_phys(virt: VirtAddr) -> PhysAddr {
    return cast(PhysAddr, virt - HHDM_OFFSET);
}

@inline proc vmm_invlpg(virt_addr: VirtAddr) -> void {
    asm ("invlpg [rdi]" : in(virt_addr) "rdi" : clobber "memory");

    return;
}

@inline proc vmm_set_cr3(pml4_phys: PhysAddr) -> void {
    asm ("mov cr3, rax" : in(pml4_phys) "rax" : clobber "memory");

    return;
}

@inline proc vmm_get_cr3() -> PhysAddr {
    return asm ("mov rax, cr3" : out "rax") -> PhysAddr;
}

@inline proc uptr_validate(ptr: u64, size: u64) -> bool {
    if (ptr < USER_SPACE_MIN_ADDR) {
        return false;
    }

    if (size == 0) {
        return ptr <= USER_SPACE_MAX_ADDR;
    }

    var end_addr: u64 = ptr + size;

    if (end_addr < ptr) {
        return false;
    }

    if ((end_addr - 1) > USER_SPACE_MAX_ADDR) {
        return false;
    }

    return true;
}

@inline proc uptr_validate_ptr(ptr: u8*, size: u64) -> bool {
    return uptr_validate(cast(u64, ptr), size);
}

@inline proc uptr_is_aligned(ptr: u64, align: u64) -> bool {
    var mask: u64 = align - 1;

    return (ptr & mask) == 0;
}

proc uptr_strnlen(str: char*, max_len: u64) -> (u64, bool) {
    var raw_ptr: u64 = cast(u64, str);

    if (!uptr_validate(raw_ptr, 1)) {
        return (0, false);
    }

    var len: u64 = 0;

    while (len < max_len) {
        var cur_addr: u64 = raw_ptr + len;

        if (cur_addr > USER_SPACE_MAX_ADDR) {
            return (0, false);
        }

        if (str[len] == cast(char, 0)) {
            return (len, true);
        }

        len += 1;
    }

    return (len, true);
}

proc vmm_create_user_space() -> (PageTable, PhysAddr, bool) {
    var (pml4_phys, ok) = pmm_alloc_page();

    if (!ok) {
        return (cast(PageTable, 0), cast(PhysAddr, 0), false);
    }

    var pml4_ptr: PageTable = cast(PageTable, phys_to_virt(pml4_phys));

    memzero_page(pml4_ptr);

    pml4_ptr[0] = g_kernel_pml4[0];

    for (var i: u64 = VMM_USER_PML4_ENTRIES; i < VMM_ENTRIES_PER_TABLE; i += 1) {
        pml4_ptr[i] = g_kernel_pml4[i];
    }

    return (pml4_ptr, pml4_phys, true);
}

proc vmm_destroy_user_space(pml4: PageTable, pml4_phys: PhysAddr) -> void {
    if (cast(u64, pml4) == 0) {
        return;
    }

    for (var i: u64 = 1; i < VMM_USER_PML4_ENTRIES; i += 1) {
        var pml4_entry: u64 = pml4[i];

        if ((pml4_entry & PTE_PRESENT) != 0) {
            var pdpt_phys: PhysAddr  = cast(PhysAddr, pml4_entry & VMM_PHYS_ADDR_MASK);
            var pdpt:      PageTable = cast(PageTable, phys_to_virt(pdpt_phys));

            for (var j: u64 = 0; j < VMM_ENTRIES_PER_TABLE; j += 1) {
                var pdpt_entry: u64 = pdpt[j];

                if ((pdpt_entry & PTE_PRESENT) != 0) {
                    var pd_phys: PhysAddr  = cast(PhysAddr, pdpt_entry & VMM_PHYS_ADDR_MASK);
                    var pd:      PageTable = cast(PageTable, phys_to_virt(pd_phys));

                    for (var k: u64 = 0; k < VMM_ENTRIES_PER_TABLE; k += 1) {
                        var pd_entry: u64 = pd[k];

                        if ((pd_entry & PTE_PRESENT) != 0) {
                            var pt_phys: PhysAddr = cast(PhysAddr, pd_entry & VMM_PHYS_ADDR_MASK);

                            pmm_free_page(pt_phys);
                        }
                    }

                    pmm_free_page(pd_phys);
                }
            }

            pmm_free_page(pdpt_phys);
        }
    }

    pmm_free_page(pml4_phys);

    return;
}

proc vmm_map_page(pml4: PageTable, virt_addr: VirtAddr, phys_addr: PhysAddr, flags: u64) -> u64 {
    var guard = g_vmm.lock_irq();
    defer guard.release_irq();

    var vmm: VmmState* = guard.get();

    var saved_pml4: PageTable = vmm.pml4;
    vmm.pml4 = pml4;

    var status: bool = vmm.map_page(virt_addr, phys_addr, flags);

    vmm.pml4 = saved_pml4;

    if (status) {
        return 1;
    }

    return 0;
}

proc vmm_unmap_page(pml4: PageTable, virt_addr: VirtAddr) -> void {
    var guard = g_vmm.lock_irq();
    defer guard.release_irq();

    var vmm: VmmState* = guard.get();

    var saved_pml4: PageTable = vmm.pml4;
    vmm.pml4 = pml4;

    vmm.unmap_page(virt_addr);

    vmm.pml4 = saved_pml4;

    return;
}

proc vmm_virt_to_phys(pml4: PageTable, virt_addr: VirtAddr) -> (PhysAddr, bool) {
    var guard = g_vmm.lock_irq();
    defer guard.release_irq();

    var vmm: VmmState* = guard.get();

    var saved_pml4: PageTable = vmm.pml4;
    vmm.pml4 = pml4;

    var result: (PhysAddr, bool) = vmm.virt_to_phys(virt_addr);

    vmm.pml4 = saved_pml4;

    return result;
}

proc vmm_map_range(pml4: PageTable, virt_start: VirtAddr, phys_start: PhysAddr, size: u64, flags: u64) -> u64 {
    var guard = g_vmm.lock_irq();
    defer guard.release_irq();

    var vmm: VmmState* = guard.get();

    var saved_pml4: PageTable = vmm.pml4;
    vmm.pml4 = pml4;

    var status: bool = vmm.map_range(virt_start, phys_start, size, flags);

    vmm.pml4 = saved_pml4;

    if (status) {
        return 1;
    }

    return 0;
}

proc vmm_init(kernel_end: VirtAddr) -> PageTable {
    g_vmm.init();

    var (pml4_phys, ok) = pmm_alloc_page();

    if (!ok) {
        return cast(PageTable, 0);
    }

    var pml4_ptr: PageTable = cast(PageTable, phys_to_virt(pml4_phys));

    memzero_page(pml4_ptr);

    var boot_cr3:  PhysAddr  = vmm_get_cr3();
    var boot_pml4: PageTable = cast(PageTable, phys_to_virt(boot_cr3));

    pml4_ptr[0]   = boot_pml4[0];
    pml4_ptr[256] = boot_pml4[256];

    vmm_set_cr3(pml4_phys);

    g_kernel_pml4 = pml4_ptr;

    var guard = g_vmm.lock_irq();
    defer guard.release_irq();

    var vmm: VmmState* = guard.get();

    vmm.pml4      = pml4_ptr;
    vmm.pml4_phys = pml4_phys;

    return pml4_ptr;
}