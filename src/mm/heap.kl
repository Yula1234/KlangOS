import "sync/spinlock.kl";

import "lib/mem.kl";

import "vmm.kl";
import "pmm.kl";

packed struct HeapBlock {
    size:    u64,
    is_free: u64,
    next:    HeapBlock*,
    prev:    HeapBlock*
}


var g_heap_start:       u64;
var g_heap_end:         u64;
var g_heap_first_block: HeapBlock*;
var g_heap_lock:        Spinlock;


proc heap_expand_unlocked(needed_bytes: u64) -> u64 {
    var pages: u64    = (needed_bytes + 4095) / 4096;
    var old_end: u64  = g_heap_end;
    var p: u64        = 0;

    while (p < pages) {
        var (phys, ok) = pmm_alloc_page();

        if (!ok) {
            return 0;
        }

        var map_status: u64 = vmm_map_page(g_kernel_pml4, g_heap_end, phys, 3);

        if (map_status == 0) {
            return 0;
        }

        g_heap_end = g_heap_end + 4096;
        p += 1;
    }

    var new_block_size: u64   = (pages * 4096) - sizeof(HeapBlock);
    var new_block: HeapBlock* = cast(HeapBlock*, old_end);

    new_block.size    = new_block_size;
    new_block.is_free = 1;
    new_block.next    = cast(HeapBlock*, 0);
    new_block.prev    = cast(HeapBlock*, 0);

    if (cast(u64, g_heap_first_block) == 0) {
        g_heap_first_block = new_block;
        return 1;
    }

    var curr: HeapBlock* = g_heap_first_block;

    while (cast(u64, curr.next) != 0) {
        curr = curr.next;
    }

    curr.next      = new_block;
    new_block.prev = curr;

    if (curr.is_free == 1) {
        if ((cast(u64, curr) + sizeof(HeapBlock) + curr.size) == cast(u64, new_block)) {
            curr.size = curr.size + sizeof(HeapBlock) + new_block.size;
            curr.next = cast(HeapBlock*, 0);
        }
    }

    return 1;
}


proc heap_init(initial_pages: u64) -> u64 {
    g_heap_lock.init();

    g_heap_start       = 0x10000000;
    g_heap_end         = 0x10000000;
    g_heap_first_block = cast(HeapBlock*, 0);

    g_heap_lock.acquire_irq();
    var status: u64 = heap_expand_unlocked(initial_pages * 4096);
    g_heap_lock.release_irq();

    return status;
}


proc kalloc(size: u64) -> u8* {
    if (size == 0) {
        return cast(u8*, 0);
    }

    var aligned_size: u64 = (size + 15) & ~15;

    g_heap_lock.acquire_irq();

    var curr: HeapBlock* = g_heap_first_block;

    while (cast(u64, curr) != 0) {
        if (curr.is_free == 1) {
            if (curr.size >= aligned_size) {
                if (curr.size >= (aligned_size + sizeof(HeapBlock) + 16)) {
                    var split_addr: u64         = cast(u64, curr) + sizeof(HeapBlock) + aligned_size;
                    var split_block: HeapBlock* = cast(HeapBlock*, split_addr);

                    split_block.size    = curr.size - sizeof(HeapBlock) - aligned_size;
                    split_block.is_free = 1;
                    split_block.next    = curr.next;
                    split_block.prev    = curr;

                    if (cast(u64, curr.next) != 0) {
                        curr.next.prev = split_block;
                    }

                    curr.next = split_block;
                    curr.size = aligned_size;
                }

                curr.is_free = 0;

                g_heap_lock.release_irq();

                return cast(u8*, cast(u64, curr) + sizeof(HeapBlock));
            }
        }

        curr = curr.next;
    }

    var expand_status: u64 = heap_expand_unlocked(aligned_size + sizeof(HeapBlock));

    if (expand_status == 0) {
        g_heap_lock.release_irq();
        return cast(u8*, 0);
    }

    g_heap_lock.release_irq();

    return kalloc(size);
}


proc kfree(ptr: u8*) -> void {
    if (cast(u64, ptr) == 0) {
        return;
    }

    var block: HeapBlock* = cast(HeapBlock*, cast(u64, ptr) - sizeof(HeapBlock));

    g_heap_lock.acquire_irq();

    block.is_free = 1;

    if (cast(u64, block.next) != 0) {
        if (block.next.is_free == 1) {
            if ((cast(u64, block) + sizeof(HeapBlock) + block.size) == cast(u64, block.next)) {
                block.size = block.size + sizeof(HeapBlock) + block.next.size;
                block.next = block.next.next;

                if (cast(u64, block.next) != 0) {
                    block.next.prev = block;
                }
            }
        }
    }

    if (cast(u64, block.prev) != 0) {
        if (block.prev.is_free == 1) {
            if ((cast(u64, block.prev) + sizeof(HeapBlock) + block.prev.size) == cast(u64, block)) {
                block.prev.size = block.prev.size + sizeof(HeapBlock) + block.size;
                block.prev.next = block.next;

                if (cast(u64, block.next) != 0) {
                    block.next.prev = block.prev;
                }
            }
        }
    }

    g_heap_lock.release_irq();

    return;
}

proc krealloc(ptr: u8*, new_size: u64) -> u8* {
    if (cast(u64, ptr) == 0) {
        return kalloc(new_size);
    }

    if (new_size == 0) {
        kfree(ptr);
        return cast(u8*, 0);
    }

    var block: HeapBlock* = cast(HeapBlock*, cast(u64, ptr) - 32);

    if (block.size >= new_size) {
        return ptr;
    }

    var new_ptr: u8* = kalloc(new_size);

    if (cast(u64, new_ptr) == 0) {
        return cast(u8*, 0);
    }

    memcpy(new_ptr, ptr, block.size);
    kfree(ptr);

    return new_ptr;
}


proc kcalloc(count: u64, size: u64) -> u8* {
    var total: u64 = count * size;
    var ptr: u8*   = kalloc(total);

    if (cast(u64, ptr) != 0) {
        memset(ptr, cast(u8, 0), total);
    }

    return ptr;
}