import "io.kl";
import "vmm.kl";
import "sync/spinlock.kl";


const MSR_APIC_BASE:            u32 = 0x0000001B;
const APIC_BASE_MASK:           u64 = 0x000FFFFFFFFFF000;
const APIC_GLOBAL_ENABLE:       u64 = 0x00000800;

const PORT_IMCR_SELECT:         u16 = 0x0022;
const PORT_IMCR_DATA:           u16 = 0x0023;

const DEFAULT_LAPIC_PHYS:       u64 = 0x00000000FEE00000;
const DEFAULT_IOAPIC_PHYS:      u64 = 0x00000000FEC00000;


const LAPIC_REG_ID:             u32 = 0x0020;
const LAPIC_REG_VERSION:        u32 = 0x0030;
const LAPIC_REG_TPR:            u32 = 0x0080;
const LAPIC_REG_EOI:            u32 = 0x00B0;
const LAPIC_REG_LDR:            u32 = 0x00D0;
const LAPIC_REG_DFR:            u32 = 0x00E0;
const LAPIC_REG_SVR:            u32 = 0x00F0;
const LAPIC_REG_ESR:            u32 = 0x0280;

const LAPIC_REG_LVT_TIMER:      u32 = 0x0320;
const LAPIC_REG_LVT_LINT0:      u32 = 0x0350;
const LAPIC_REG_LVT_LINT1:      u32 = 0x0360;
const LAPIC_REG_LVT_ERROR:      u32 = 0x0370;

const LAPIC_REG_TIMER_INIT:     u32 = 0x0380;
const LAPIC_REG_TIMER_CURR:     u32 = 0x0390;
const LAPIC_REG_TIMER_DIV:      u32 = 0x03E0;


const IOAPIC_REGSEL:            u64 = 0x00;
const IOAPIC_IOWIN:             u64 = 0x10;

const IOAPIC_ID:                u8  = 0x00;
const IOAPIC_VERSION:           u8  = 0x01;
const IOAPIC_REDTBL_BASE:       u8  = 0x10;


var g_lapic_base:               u64;
var g_ioapic_base:              u64;
var g_ioapic_max_redirections:  u32;
var g_ioapic_lock:              Spinlock;


proc msr_read(msr: u32) -> u64 {
    asm "mov ecx, edi";
    asm "rdmsr";
    asm "shl rdx, 32";
    return asm "or rax, rdx" -> u64;
}


proc msr_write(msr: u32, val: u64) -> void {
    asm "mov ecx, edi";
    asm "mov eax, esi";
    asm "mov rdx, rsi";
    asm "shr rdx, 32";
    asm "wrmsr";

    return;
}


proc pic_disable() -> void {
    io_outb(PORT_IMCR_SELECT, 0x70);
    io_wait();
    io_outb(PORT_IMCR_DATA, 0x01);
    io_wait();

    io_outb(PORT_PIC1_CMD, 0x11);
    io_wait();
    io_outb(PORT_PIC2_CMD, 0x11);
    io_wait();

    io_outb(PORT_PIC1_DATA, 0x20);
    io_wait();
    io_outb(PORT_PIC2_DATA, 0x28);
    io_wait();

    io_outb(PORT_PIC1_DATA, 0x04);
    io_wait();
    io_outb(PORT_PIC2_DATA, 0x02);
    io_wait();

    io_outb(PORT_PIC1_DATA, 0x01);
    io_wait();
    io_outb(PORT_PIC2_DATA, 0x01);
    io_wait();

    io_outb(PORT_PIC1_DATA, 0xFF);
    io_wait();
    io_outb(PORT_PIC2_DATA, 0xFF);
    io_wait();

    return;
}


proc lapic_write(reg: u32, val: u32) -> void {
    var ptr: u32* = cast(u32*, g_lapic_base + cast(u64, reg));
    ptr[0] = val;

    return;
}


proc lapic_read(reg: u32) -> u32 {
    var ptr: u32* = cast(u32*, g_lapic_base + cast(u64, reg));
    return ptr[0];
}


proc lapic_eoi() -> void {
    lapic_write(LAPIC_REG_EOI, 0);

    return;
}


proc lapic_get_id() -> u32 {
    return (lapic_read(LAPIC_REG_ID) >> 24) & 0xFF;
}


proc lapic_get_version() -> u32 {
    return lapic_read(LAPIC_REG_VERSION);
}


proc lapic_get_current_count() -> u32 {
    return lapic_read(LAPIC_REG_TIMER_CURR);
}


proc lapic_get_svr() -> u32 {
    return lapic_read(LAPIC_REG_SVR);
}


proc lapic_init() -> void {
    var apic_base_msr: u64 = msr_read(MSR_APIC_BASE);
    var phys_addr: u64     = apic_base_msr & APIC_BASE_MASK;

    if (phys_addr == 0) {
        phys_addr = DEFAULT_LAPIC_PHYS;
    }

    g_lapic_base = phys_addr;

    vmm_map_page(g_kernel_pml4, g_lapic_base, g_lapic_base, 27);

    msr_write(MSR_APIC_BASE, apic_base_msr | APIC_GLOBAL_ENABLE);

    lapic_write(LAPIC_REG_SVR, 0x01FF);

    asm "xor eax, eax";
    asm "mov cr8, rax";
    lapic_write(LAPIC_REG_TPR, 0);

    lapic_write(LAPIC_REG_DFR, 0xFFFFFFFF);
    lapic_write(LAPIC_REG_LDR, 0x01000000);

    lapic_write(LAPIC_REG_LVT_LINT0, 0x00010000);
    lapic_write(LAPIC_REG_LVT_LINT1, 0x00010000);
    lapic_write(LAPIC_REG_LVT_ERROR, 0x00010000);

    lapic_write(LAPIC_REG_ESR, 0);
    lapic_eoi();
    lapic_eoi();

    return;
}


proc lapic_timer_init(vector: u8, initial_count: u32, is_periodic: bool) -> void {
    lapic_write(LAPIC_REG_TIMER_DIV, 0x03);

    var mode_flags: u32 = cast(u32, vector);

    if (is_periodic) {
        mode_flags = mode_flags | 0x00020000;
    }

    lapic_write(LAPIC_REG_LVT_TIMER, mode_flags);

    lapic_write(LAPIC_REG_TIMER_INIT, initial_count);

    return;
}


proc lapic_timer_stop() -> void {
    lapic_write(LAPIC_REG_TIMER_INIT, 0);
    lapic_write(LAPIC_REG_LVT_TIMER, 0x00010000);

    return;
}


proc ioapic_write_unlocked(reg: u8, val: u32) -> void {
    var regsel: u32* = cast(u32*, g_ioapic_base + IOAPIC_REGSEL);
    var iowin:  u32* = cast(u32*, g_ioapic_base + IOAPIC_IOWIN);

    regsel[0] = cast(u32, reg);
    iowin[0]  = val;

    return;
}


proc ioapic_read_unlocked(reg: u8) -> u32 {
    var regsel: u32* = cast(u32*, g_ioapic_base + IOAPIC_REGSEL);
    var iowin:  u32* = cast(u32*, g_ioapic_base + IOAPIC_IOWIN);

    regsel[0] = cast(u32, reg);
    return iowin[0];
}


proc ioapic_write(reg: u8, val: u32) -> void {
    g_ioapic_lock.acquire_irq();
    ioapic_write_unlocked(reg, val);
    g_ioapic_lock.release_irq();

    return;
}


proc ioapic_read(reg: u8) -> u32 {
    g_ioapic_lock.acquire_irq();
    var val: u32 = ioapic_read_unlocked(reg);
    g_ioapic_lock.release_irq();

    return val;
}


proc ioapic_set_entry(irq: u8, entry_low: u32, entry_high: u32) -> void {
    var reg_low:  u8 = IOAPIC_REDTBL_BASE + (irq * 2);
    var reg_high: u8 = reg_low + 1;

    g_ioapic_lock.acquire_irq();

    ioapic_write_unlocked(reg_low, entry_low | 0x00010000);
    ioapic_write_unlocked(reg_high, entry_high);
    ioapic_write_unlocked(reg_low, entry_low);

    g_ioapic_lock.release_irq();

    return;
}


proc ioapic_mask_irq(irq: u8) -> void {
    var reg_low: u8 = IOAPIC_REDTBL_BASE + (irq * 2);

    g_ioapic_lock.acquire_irq();

    var current: u32 = ioapic_read_unlocked(reg_low);
    ioapic_write_unlocked(reg_low, current | 0x00010000);

    g_ioapic_lock.release_irq();

    return;
}


proc ioapic_unmask_irq(irq: u8) -> void {
    var reg_low: u8 = IOAPIC_REDTBL_BASE + (irq * 2);

    g_ioapic_lock.acquire_irq();

    var current: u32 = ioapic_read_unlocked(reg_low);
    ioapic_write_unlocked(reg_low, current & ~0x00010000);

    g_ioapic_lock.release_irq();

    return;
}


proc ioapic_route_isa_irq(irq: u8, vector: u8, dest_apic_id: u8) -> void {
    var low:  u32 = cast(u32, vector);
    var high: u32 = cast(u32, dest_apic_id) << 24;

    ioapic_set_entry(irq, low, high);

    return;
}


proc ioapic_init() -> void {
    g_ioapic_lock.init();

    g_ioapic_base = DEFAULT_IOAPIC_PHYS;

    vmm_map_page(g_kernel_pml4, g_ioapic_base, g_ioapic_base, 27);

    var ver_reg: u32 = ioapic_read(IOAPIC_VERSION);
    g_ioapic_max_redirections = ((ver_reg >> 16) & 0xFF) + 1;

    var i: u8 = 0;

    while (i < cast(u8, g_ioapic_max_redirections)) {
        ioapic_set_entry(i, 0x00010000 | (32 + cast(u32, i)), 0);
        i += 1;
    }

    return;
}


proc apic_init() -> void {
    pic_disable();
    lapic_init();
    ioapic_init();

    return;
}