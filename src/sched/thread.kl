import "lib/list.kl";

enum ThreadState: u8 {
    READY = 1,
    RUNNING,
    BLOCKED,
    SLEEPING,
    DEAD
}

const THREAD_STACK_SIZE: u64 = 16384;


packed struct Thread {
    sched_node:  ListNode,
    wait_node:   ListNode,
    id:          u64 = 0,
    rsp:         u64 = 0,
    state:       ThreadState = ThreadState.READY,
    stack_base:  u64 = 0,
    stack_size:  u64 = THREAD_STACK_SIZE,
    sleep_ticks: u64 = 0,

    @inline proc is_ready(t: Thread*) -> bool {
        return t.state == ThreadState.READY;
    }

    @inline proc is_running(t: Thread*) -> bool {
        return t.state == ThreadState.RUNNING;
    }

    @inline proc is_sleeping(t: Thread*) -> bool {
        return t.state == ThreadState.SLEEPING;
    }

    @inline proc is_dead(t: Thread*) -> bool {
        return t.state == ThreadState.DEAD;
    }

    @inline proc block(t: Thread*) -> void {
        t.state = ThreadState.BLOCKED;

        return;
    }

    @inline proc unblock(t: Thread*) -> void {
        t.state = ThreadState.READY;

        return;
    }

    @inline proc terminate(t: Thread*) -> void {
        t.state = ThreadState.DEAD;

        return;
    }
}


@inline proc thread_from_sched_node(node: ListNode*) -> Thread* {
    return cast(Thread*, cast(u64, node) - offsetof(Thread, sched_node));
}


@inline proc thread_from_wait_node(node: ListNode*) -> Thread* {
    return cast(Thread*, cast(u64, node) - offsetof(Thread, wait_node));
}