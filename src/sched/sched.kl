import "arch/x86_64/isr.kl";
import "arch/x86_64/gdt.kl";
import "arch/x86_64/syscall.kl";

import "sync/spinlock.kl";

import "lib/list.kl";

import "mm/heap.kl";
import "mm/vmm.kl";
import "mm/pmm.kl";

import "thread.kl";
import "process.kl";

const DEFAULT_RFLAGS:     u64 = 0x0202;
const KERNEL_CS:          u64 = 0x08;
const KERNEL_SS:          u64 = 0x10;
const USER_CS:            u64 = 0x23;
const USER_SS:            u64 = 0x1B;

const REAPER_SLEEP_TICKS: u64 = 50;

struct SchedState {
    threads:   ListNode,
    current:   Thread*,
    idle:      Thread*,
    next_id:   u64,
    is_active: bool,

    proc init(s: SchedState*) -> void {
        s.threads.init();
        s.current   = cast(Thread*, 0);
        s.idle      = cast(Thread*, 0);
        s.next_id   = 1;
        s.is_active = false;

        return;
    }

    proc add_thread(s: SchedState*, t: Thread*) -> void {
        s.threads.add_tail(&t.sched_node);

        return;
    }

    proc wake_sleeping_threads(s: SchedState*, current_ticks: u64) -> void {
        var curr_node: ListNode* = s.threads.next;

        while (curr_node != &s.threads) {
            var t: Thread* = thread_from_sched_node(curr_node);

            if (t.is_sleeping()) {
                if (current_ticks >= t.sleep_ticks) {
                    t.unblock();
                }
            }

            curr_node = curr_node.next;
        }

        return;
    }

    proc select_next_thread(s: SchedState*) -> Thread* {
        if (cast(u64, s.current) == 0) {
            return s.idle;
        }

        var start_node: ListNode* = s.current.sched_node.next;

        if (start_node == &s.threads) {
            start_node = s.threads.next;
        }

        var curr_node: ListNode* = start_node;

        while (curr_node != &s.threads) {
            var t: Thread* = thread_from_sched_node(curr_node);

            if (t.is_ready()) {
                return t;
            }

            curr_node = curr_node.next;
        }

        curr_node = s.threads.next;

        while (curr_node != start_node) {
            var t: Thread* = thread_from_sched_node(curr_node);

            if (t.is_ready()) {
                return t;
            }

            curr_node = curr_node.next;
        }

        return s.idle;
    }

    proc reap_dead_threads(s: SchedState*) -> void {
        var curr_node: ListNode* = s.threads.next;

        while (curr_node != &s.threads) {
            var next_node: ListNode* = curr_node.next;
            var t: Thread*           = thread_from_sched_node(curr_node);

            if (t.is_dead()) {
                curr_node.remove();

                var stack_to_free:  u8* = cast(u8*, t.stack_base);
                var thread_to_free: u8* = cast(u8*, t);

                if (cast(u64, stack_to_free) != 0) {
                    kfree(stack_to_free);
                }

                kfree(thread_to_free);
            }

            curr_node = next_node;
        }

        return;
    }
}

var g_sched:          Spinlocked[SchedState];
var g_current_thread: Thread*;
var g_sched_active:   bool;

proc sched_reap_dead_threads() -> void {
    var guard = g_sched.lock_irq();
    defer guard.release_irq();

    guard.get().reap_dead_threads();

    return;
}

proc reaper_task(arg: u64) -> void {
    while (1) {
        sched_reap_dead_threads();
        thread_sleep(REAPER_SLEEP_TICKS);
    }

    return;
}

proc sched_init() -> void {
    g_sched.init();

    var idle: Thread* = cast(Thread*, kalloc(sizeof(Thread)));

    idle[0] = Thread {
        id:               0,
        rsp:              0,
        kernel_stack_top: 0,
        user_stack_top:   0,
        state:            ThreadState.RUNNING,
        stack_base:       0,
        stack_size:       0,
        process:          cast(Process*, 0),
        is_user:          false
    };

    idle.sched_node.init();
    idle.wait_node.init();

    g_current_thread = idle;
    g_sched_active   = false;

    {
        var guard = g_sched.lock_irq();
        defer guard.release_irq();

        var sched: SchedState* = guard.get();
        sched.init();

        sched.idle    = idle;
        sched.current = idle;

        sched.add_thread(idle);
    }

    thread_create(cast(u64, reaper_task), 0);

    {
        var guard = g_sched.lock_irq();
        defer guard.release_irq();

        guard.get().is_active = true;
    }

    g_sched_active = true;

    return;
}

proc thread_create(entry_point: u64, arg: u64) -> Thread* {
    var t:         Thread* = cast(Thread*, kalloc(sizeof(Thread)));
    var stack_mem: u8*     = kalloc(THREAD_STACK_SIZE);
    var stack_top: u64     = (cast(u64, stack_mem) + THREAD_STACK_SIZE) & ~15;

    var frame_addr: u64        = stack_top - sizeof(InterruptFrame);
    var frame: InterruptFrame* = cast(InterruptFrame*, frame_addr);

    frame[0] = InterruptFrame {
        rdi:    arg,
        rip:    entry_point,
        cs:     KERNEL_CS,
        rflags: DEFAULT_RFLAGS,
        rsp:    stack_top,
        ss:     KERNEL_SS
    };

    var guard = g_sched.lock_irq();
    defer guard.release_irq();

    var sched: SchedState* = guard.get();

    t[0] = Thread {
        id:               sched.next_id,
        rsp:              frame_addr,
        kernel_stack_top: stack_top,
        user_stack_top:   0,
        state:            ThreadState.READY,
        stack_base:       cast(u64, stack_mem),
        stack_size:       THREAD_STACK_SIZE,
        process:          cast(Process*, 0),
        is_user:          false
    };

    t.sched_node.init();
    t.wait_node.init();

    sched.next_id = sched.next_id + 1;
    sched.add_thread(t);

    return t;
}

proc thread_create_user(proc_ptr: Process*, entry_point: u64, user_stack_top: u64, arg: u64) -> Thread* {
    var t:         Thread* = cast(Thread*, kalloc(sizeof(Thread)));
    var stack_mem: u8*     = kalloc(THREAD_STACK_SIZE);
    var stack_top: u64     = (cast(u64, stack_mem) + THREAD_STACK_SIZE) & ~15;

    var frame_addr: u64        = stack_top - sizeof(InterruptFrame);
    var frame: InterruptFrame* = cast(InterruptFrame*, frame_addr);

    frame[0] = InterruptFrame {
        rdi:    arg,
        rip:    entry_point,
        cs:     USER_CS,
        rflags: DEFAULT_RFLAGS,
        rsp:    user_stack_top,
        ss:     USER_SS
    };

    var guard = g_sched.lock_irq();
    defer guard.release_irq();

    var sched: SchedState* = guard.get();

    t[0] = Thread {
        id:               sched.next_id,
        rsp:              frame_addr,
        kernel_stack_top: stack_top,
        user_stack_top:   user_stack_top,
        state:            ThreadState.READY,
        stack_base:       cast(u64, stack_mem),
        stack_size:       THREAD_STACK_SIZE,
        process:          proc_ptr,
        is_user:          true
    };

    t.sched_node.init();
    t.wait_node.init();

    if (cast(u64, proc_ptr) != 0) {
        proc_ptr.thread_count = proc_ptr.thread_count + 1;
    }

    sched.next_id = sched.next_id + 1;
    sched.add_thread(t);

    return t;
}

proc sched_schedule(current_rsp: u64) -> u64 {
    if (!g_sched_active) {
        return current_rsp;
    }

    var guard = g_sched.lock_irq();
    defer guard.release_irq();

    var sched: SchedState* = guard.get();

    if (!sched.is_active) {
        return current_rsp;
    }

    if (cast(u64, sched.current) != 0) {
        sched.current.rsp = current_rsp;

        if (sched.current.is_running()) {
            sched.current.state = ThreadState.READY;
        }
    }

    sched.wake_sleeping_threads(g_timer_ticks);

    var next_thread: Thread* = sched.select_next_thread();

    sched.current    = next_thread;
    g_current_thread = next_thread;

    next_thread.state = ThreadState.RUNNING;

    g_tss.rsp0           = next_thread.kernel_stack_top;
    g_syscall_kernel_rsp = next_thread.kernel_stack_top;

    if (cast(u64, next_thread.process) != 0) {
        var target_cr3: PhysAddr = next_thread.process.cr3;

        if (vmm_get_cr3() != target_cr3) {
            vmm_set_cr3(target_cr3);
        }
    } else {
        var kernel_cr3: PhysAddr = virt_to_phys(cast(VirtAddr, g_kernel_pml4));

        if (vmm_get_cr3() != kernel_cr3) {
            vmm_set_cr3(kernel_cr3);
        }
    }

    return next_thread.rsp;
}

proc thread_yield() -> void {
    asm "int 34";

    return;
}

proc thread_sleep(ticks: u64) -> void {
    {
        var guard = g_sched.lock_irq();
        defer guard.release_irq();

        var sched: SchedState* = guard.get();

        sched.current.sleep_ticks = g_timer_ticks + ticks;
        sched.current.block();
        sched.current.state = ThreadState.SLEEPING;
    }

    thread_yield();

    return;
}

proc thread_exit() -> void {
    {
        var guard = g_sched.lock_irq();
        defer guard.release_irq();

        guard.get().current.terminate();
    }

    thread_yield();

    while (1) {
        asm "hlt";
    }

    return;
}