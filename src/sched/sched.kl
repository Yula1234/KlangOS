import "arch/x86_64/isr.kl";

import "sync/spinlock.kl";

import "lib/list.kl";

import "mm/heap.kl";

import "thread.kl";


var g_thread_list_head: ListNode;
var g_current_thread:   Thread*;
var g_idle_thread:      Thread*;
var g_next_thread_id:   u64;
var g_sched_active:     bool;
var g_sched_lock:       Spinlock;


proc sched_reap_dead_threads() -> void {
    g_sched_lock.acquire_irq();

    var curr_node: ListNode* = g_thread_list_head.next;

    while (curr_node != &g_thread_list_head) {
        var next_node: ListNode* = curr_node.next;
        var t: Thread*           = thread_from_sched_node(curr_node);

        if (t.state == ThreadState.DEAD) {
            curr_node.remove();

            var stack_to_free: u8*  = cast(u8*, t.stack_base);
            var thread_to_free: u8* = cast(u8*, t);

            if (cast(u64, stack_to_free) != 0) {
                kfree(stack_to_free);
            }

            kfree(thread_to_free);
        }

        curr_node = next_node;
    }

    g_sched_lock.release_irq();

    return;
}


proc reaper_task(arg: u64) -> void {
    while (1) {
        sched_reap_dead_threads();
        thread_sleep(50);
    }

    return;
}


proc sched_init() -> void {
    g_sched_lock.init();
    g_thread_list_head.init();

    g_next_thread_id = 1;
    g_sched_active   = false;

    var idle: Thread* = cast(Thread*, kalloc(sizeof(Thread)));
    idle[0] = Thread {
        id:    0,
        state: ThreadState.RUNNING
    };

    idle.sched_node.init();
    idle.wait_node.init();

    g_idle_thread    = idle;
    g_current_thread = idle;

    g_sched_lock.acquire_irq();
    g_thread_list_head.add_tail(&idle.sched_node);
    g_sched_lock.release_irq();

    thread_create(cast(u64, reaper_task), 0);

    g_sched_active   = true;

    return;
}

proc thread_create(entry_point: u64, arg: u64) -> Thread* {
    var t: Thread*      = cast(Thread*, kalloc(sizeof(Thread)));
    var stack_mem: u8*  = kalloc(THREAD_STACK_SIZE);
    var stack_top: u64  = (cast(u64, stack_mem) + THREAD_STACK_SIZE) & ~15;

    var frame_addr: u64 = stack_top - sizeof(InterruptFrame);
    var frame: InterruptFrame* = cast(InterruptFrame*, frame_addr);

    frame[0] = InterruptFrame {
        rdi: arg,
        rip: entry_point,
        rsp: stack_top
    };

    t[0] = Thread {
        id:         g_next_thread_id,
        rsp:        frame_addr,
        stack_base: cast(u64, stack_mem)
    };

    t.sched_node.init();
    t.wait_node.init();

    g_sched_lock.acquire_irq();

    g_next_thread_id = g_next_thread_id + 1;
    g_thread_list_head.add_tail(&t.sched_node);

    g_sched_lock.release_irq();

    return t;
}


proc sched_schedule(current_rsp: u64) -> u64 {
    if (!g_sched_active) {
        return current_rsp;
    }

    g_sched_lock.acquire_irq();

    if (cast(u64, g_current_thread) != 0) {
        g_current_thread.rsp = current_rsp;

        if (g_current_thread.state == ThreadState.RUNNING) {
            g_current_thread.state = ThreadState.READY;
        }
    }

    var curr_node: ListNode* = g_thread_list_head.next;

    while (curr_node != &g_thread_list_head) {
        var t: Thread* = thread_from_sched_node(curr_node);

        if (t.state == ThreadState.SLEEPING) {
            if (g_timer_ticks >= t.sleep_ticks) {
                t.state = ThreadState.READY;
            }
        }

        curr_node = curr_node.next;
    }

    var next_thread: Thread* = cast(Thread*, 0);
    var start_node: ListNode* = g_current_thread.sched_node.next;

    if (start_node == &g_thread_list_head) {
        start_node = g_thread_list_head.next;
    }

    curr_node = start_node;

    while (curr_node != &g_thread_list_head) {
        var t: Thread* = thread_from_sched_node(curr_node);

        if (t.state == ThreadState.READY) {
            next_thread = t;
            break;
        }

        curr_node = curr_node.next;
    }

    if (cast(u64, next_thread) == 0) {
        curr_node = g_thread_list_head.next;

        while (curr_node != start_node) {
            var t: Thread* = thread_from_sched_node(curr_node);

            if (t.state == ThreadState.READY) {
                next_thread = t;
                break;
            }

            curr_node = curr_node.next;
        }
    }

    if (cast(u64, next_thread) == 0) {
        next_thread = g_idle_thread;
    }

    g_current_thread       = next_thread;
    g_current_thread.state = ThreadState.RUNNING;

    var new_rsp: u64       = g_current_thread.rsp;

    g_sched_lock.release_irq();

    return new_rsp;
}


proc thread_yield() -> void {
    asm "int 34";

    return;
}


proc thread_sleep(ticks: u64) -> void {
    g_sched_lock.acquire_irq();

    g_current_thread.sleep_ticks = g_timer_ticks + ticks;
    g_current_thread.state       = ThreadState.SLEEPING;

    g_sched_lock.release_irq();

    thread_yield();

    return;
}


proc thread_exit() -> void {
    g_sched_lock.acquire_irq();

    g_current_thread.state = ThreadState.DEAD;

    g_sched_lock.release_irq();

    thread_yield();

    while (1) {
        asm "hlt";
    }

    return;
}