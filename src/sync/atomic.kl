    }

    @inline proc add(a: Atomic64*, val: i64) -> i64 {
        return asm ("lock xadd [rdi], rax" : in(&a.value) "rdi", in(val) "rax" : out "rax" : clobber "memory") -> i64;
    }

    @inline proc sub(a: Atomic64*, val: i64) -> i64 {
        var neg_val: i64 = -val;

        return asm ("lock xadd [rdi], rax" : in(&a.value) "rdi", in(neg_val) "rax" : out "rax" : clobber "memory") -> i64;
    }

    @inline proc inc(a: Atomic64*) -> void {
        asm ("lock inc qword [rdi]" : in(&a.value) "rdi" : clobber "memory");

        return;
