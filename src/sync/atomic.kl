@inline proc atomic_xchg_32(ptr: u32*, val: u32) -> u32 {
    return asm ("xchg [rdi], eax" : in(ptr) "rdi", in(val) "eax" : out "eax" : clobber "memory") -> u32;
}

@inline proc atomic_xchg_64(ptr: u64*, val: u64) -> u64 {
    return asm ("xchg [rdi], rax" : in(ptr) "rdi", in(val) "rax" : out "rax" : clobber "memory") -> u64;
}

@inline proc atomic_cas_32(ptr: u32*, expected: u32, desired: u32) -> u32 {
    return asm ("lock cmpxchg [rdi], edx" : in(ptr) "rdi", in(expected) "eax", in(desired) "edx" : out "eax" : clobber "memory") -> u32;
}

@inline proc atomic_cas_64(ptr: u64*, expected: u64, desired: u64) -> u64 {
    return asm ("lock cmpxchg [rdi], rdx" : in(ptr) "rdi", in(expected) "rax", in(desired) "rdx" : out "rax" : clobber "memory") -> u64;
}

@inline proc atomic_add_32(ptr: u32*, val: u32) -> u32 {
    return asm ("lock xadd [rdi], eax" : in(ptr) "rdi", in(val) "eax" : out "eax" : clobber "memory") -> u32;
}

@inline proc atomic_add_64(ptr: u64*, val: u64) -> u64 {
    return asm ("lock xadd [rdi], rax" : in(ptr) "rdi", in(val) "rax" : out "rax" : clobber "memory") -> u64;
}

@inline proc atomic_inc_32(ptr: u32*) -> void {
    asm ("lock inc dword [rdi]" : in(ptr) "rdi" : clobber "memory");

    return;
}

@inline proc atomic_dec_32(ptr: u32*) -> void {
    asm ("lock dec dword [rdi]" : in(ptr) "rdi" : clobber "memory");

    return;
}

@inline proc atomic_inc_64(ptr: u64*) -> void {
    asm ("lock inc qword [rdi]" : in(ptr) "rdi" : clobber "memory");

    return;
}

@inline proc atomic_dec_64(ptr: u64*) -> void {
    asm ("lock dec qword [rdi]" : in(ptr) "rdi" : clobber "memory");

    return;
}

packed struct Atomic {
    value: i32,

    @inline proc init(a: Atomic*, val: i32) -> void {
        a.value = val;

        return;
    }

    @inline proc get(a: Atomic*) -> i32 {
        return a.value;
    }

    @inline proc set(a: Atomic*, val: i32) -> void {
        a.value = val;

        return;
    }

    @inline proc xchg(a: Atomic*, val: i32) -> i32 {
        return asm ("xchg [rdi], eax" : in(&a.value) "rdi", in(val) "eax" : out "eax" : clobber "memory") -> i32;
    }

    @inline proc cas(a: Atomic*, expected: i32, desired: i32) -> i32 {
        return asm ("lock cmpxchg [rdi], edx" : in(&a.value) "rdi", in(expected) "eax", in(desired) "edx" : out "eax" : clobber "memory") -> i32;
    }

    @inline proc add(a: Atomic*, val: i32) -> i32 {
        return asm ("lock xadd [rdi], eax" : in(&a.value) "rdi", in(val) "eax" : out "eax" : clobber "memory") -> i32;
    }

    @inline proc sub(a: Atomic*, val: i32) -> i32 {
        var neg_val: i32 = -val;

        return asm ("lock xadd [rdi], eax" : in(&a.value) "rdi", in(neg_val) "eax" : out "eax" : clobber "memory") -> i32;
    }

    @inline proc inc(a: Atomic*) -> void {
        asm ("lock inc dword [rdi]" : in(&a.value) "rdi" : clobber "memory");

        return;
    }

    @inline proc dec(a: Atomic*) -> void {
        asm ("lock dec dword [rdi]" : in(&a.value) "rdi" : clobber "memory");

        return;
    }

    @inline proc dec_and_test(a: Atomic*) -> bool {
        return asm ("lock dec dword [rdi]\n    sete al" : in(&a.value) "rdi" : out "al" : clobber "memory") -> bool;
    }

    @inline proc inc_and_test(a: Atomic*) -> bool {
        return asm ("lock inc dword [rdi]\n    sete al" : in(&a.value) "rdi" : out "al" : clobber "memory") -> bool;
    }
}

packed struct Atomic64 {
    value: i64,

    @inline proc init(a: Atomic64*, val: i64) -> void {
        a.value = val;

        return;
