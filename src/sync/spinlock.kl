import "arch/x86_64/cpu.kl";

import "sync/atomic.kl";

packed struct Spinlock {
    locked: Atomic,
    rflags: u64,

    @inline proc init(s: Spinlock*) -> void {
        s.locked.init(0);
        s.rflags = 0;

        return;
    }

    @inline proc is_locked(s: Spinlock*) -> bool {
        return s.locked.get() != 0;
    }

    @inline proc try_acquire(s: Spinlock*) -> bool {
        return s.locked.xchg(1) == 0;
    }

    proc acquire(s: Spinlock*) -> void {
        while (!s.try_acquire()) {
            while (s.is_locked()) {
                cpu_pause();
            }
        }

        return;
    }

    @inline proc release(s: Spinlock*) -> void {
        s.locked.set(0);

        return;
    }

    proc acquire_irq(s: Spinlock*) -> void {
        var flags: u64 = cpu_save_flags_and_cli();

        while (!s.try_acquire()) {
            while (s.is_locked()) {
                cpu_pause();
            }
        }

        s.rflags = flags;

        return;
    }

    @inline proc release_irq(s: Spinlock*) -> void {
        var saved_flags: u64 = s.rflags;

        s.locked.set(0);

        cpu_restore_flags(saved_flags);

        return;
    }
}

struct SpinlockGuard[T] {
    lock: Spinlock*,
    data: T*,

    @inline proc get(g: SpinlockGuard[T]*) -> T* {
        return g.data;
    }

    @inline proc release(g: SpinlockGuard[T]*) -> void {
        g.lock.release();

        return;
    }

    @inline proc release_irq(g: SpinlockGuard[T]*) -> void {
        g.lock.release_irq();

        return;
    }
}

struct Spinlocked[T] {
    lock: Spinlock,
    data: T,

    @inline proc init(s: Spinlocked[T]*) -> void {
        s.lock.init();

        return;
    }

    @inline proc is_locked(s: Spinlocked[T]*) -> bool {
        return s.lock.is_locked();
    }

    @inline proc lock(s: Spinlocked[T]*) -> SpinlockGuard[T] {
        s.lock.acquire();

        return SpinlockGuard[T] {
            lock: &s.lock,
            data: &s.data
        };
    }

    @inline proc lock_irq(s: Spinlocked[T]*) -> SpinlockGuard[T] {
        s.lock.acquire_irq();

        return SpinlockGuard[T] {
            lock: &s.lock,
            data: &s.data
        };
    }

    proc try_lock(s: Spinlocked[T]*) -> (SpinlockGuard[T], bool) {
        if (s.lock.try_acquire()) {
            var guard: SpinlockGuard[T] = SpinlockGuard[T] {
                lock: &s.lock,
                data: &s.data
            };

            return (guard, true);
        }

        var empty_guard: SpinlockGuard[T] = SpinlockGuard[T] {
            lock: cast(Spinlock*, 0),
            data: cast(T*, 0)
        };

        return (empty_guard, false);
    }
}