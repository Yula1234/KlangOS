import "arch/x86_64/cpu.kl";

import "sync/atomic.kl";

packed struct Spinlock {
    locked: Atomic,
    rflags: u64,

    proc init(s: Spinlock*) -> void {
        s.locked.init(0);
        s.rflags = 0;

        return;
    }

    proc is_locked(s: Spinlock*) -> bool {
        return s.locked.get() != 0;
    }

    proc try_acquire(s: Spinlock*) -> bool {
        return s.locked.xchg(1) == 0;
    }

    proc acquire(s: Spinlock*) -> void {
        while (!s.try_acquire()) {
            while (s.is_locked()) {
                cpu_pause();
            }
        }

        return;
    }

    proc release(s: Spinlock*) -> void {
        s.locked.set(0);

        return;
    }

    proc acquire_irq(s: Spinlock*) -> void {
        var flags: u64 = cpu_save_flags_and_cli();

        while (!s.try_acquire()) {
            while (s.is_locked()) {
                cpu_pause();
            }
        }

        s.rflags = flags;

        return;
    }

    proc release_irq(s: Spinlock*) -> void {
        var saved_flags: u64 = s.rflags;

        s.locked.set(0);

        cpu_restore_flags(saved_flags);

        return;
    }
}