import "sync/spinlock.kl";

import "sched/thread.kl";
import "sched/sched.kl";


packed struct WaitNode {
    thread: Thread*,
    next:   WaitNode*
}


packed struct WaitQueue {
    head: WaitNode*,
    tail: WaitNode*,
    lock: Spinlock,

    proc init(wq: WaitQueue*) -> void {
        wq.head = cast(WaitNode*, 0);
        wq.tail = cast(WaitNode*, 0);
        
        wq.lock.init();

        return;
    }

    proc enqueue_unlocked(wq: WaitQueue*, node: WaitNode*) -> void {
        node.next = cast(WaitNode*, 0);

        if (cast(u64, wq.head) == 0) {
            wq.head = node;
            wq.tail = node;
            return;
        }

        wq.tail.next = node;
        wq.tail      = node;

        return;
    }

    proc dequeue_unlocked(wq: WaitQueue*) -> Thread* {
        if (cast(u64, wq.head) == 0) {
            return cast(Thread*, 0);
        }

        var node: WaitNode* = wq.head;
        var t: Thread*      = node.thread;

        wq.head = node.next;

        if (cast(u64, wq.head) == 0) {
            wq.tail = cast(WaitNode*, 0);
        }

        return t;
    }

    proc is_empty(wq: WaitQueue*) -> bool {
        wq.lock.acquire_irq();
        var empty: bool = cast(u64, wq.head) == 0;
        wq.lock.release_irq();

        return empty;
    }

    proc wait(wq: WaitQueue*) -> void {
        var node: WaitNode;

        node.thread = g_current_thread;
        node.next   = cast(WaitNode*, 0);

        wq.lock.acquire_irq();

        wq.enqueue_unlocked(&node);

        g_current_thread.state = THREAD_STATE_BLOCKED;

        wq.lock.release_irq();

        thread_yield();

        return;
    }

    proc wake_one(wq: WaitQueue*) -> bool {
        wq.lock.acquire_irq();

        var t: Thread* = wq.dequeue_unlocked();

        if (cast(u64, t) != 0) {
            t.state = THREAD_STATE_READY;
            wq.lock.release_irq();
            return true;
        }

        wq.lock.release_irq();

        return false;
    }

    proc wake_all(wq: WaitQueue*) -> u64 {
        wq.lock.acquire_irq();

        var count: u64 = 0;

        while (cast(u64, wq.head) != 0) {
            var t: Thread* = wq.dequeue_unlocked();

            if (cast(u64, t) != 0) {
                t.state = THREAD_STATE_READY;
                count   = count + 1;
            }
        }

        wq.lock.release_irq();

        return count;
    }
}