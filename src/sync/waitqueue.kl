import "sync/spinlock.kl";

import "lib/list.kl";

import "sched/thread.kl";
import "sched/sched.kl";


packed struct WaitQueue {
    head: ListNode,
    lock: Spinlock,

    proc init(wq: WaitQueue*) -> void {
        wq.head.init();
        wq.lock.init();

        return;
    }

    proc is_empty(wq: WaitQueue*) -> bool {
        wq.lock.acquire_irq();
        var empty: bool = wq.head.is_empty();
        wq.lock.release_irq();

        return empty;
    }

    proc wait(wq: WaitQueue*) -> void {
        wq.lock.acquire_irq();

        wq.head.add_tail(&g_current_thread.wait_node);
        g_current_thread.state = THREAD_STATE_BLOCKED;

        wq.lock.release_irq();

        thread_yield();

        return;
    }

    proc wake_one(wq: WaitQueue*) -> bool {
        wq.lock.acquire_irq();

        var node: ListNode* = wq.head.pop_head();

        if (cast(u64, node) != 0) {
            var t: Thread* = thread_from_wait_node(node);
            t.state = THREAD_STATE_READY;
            wq.lock.release_irq();
            return true;
        }

        wq.lock.release_irq();

        return false;
    }

    proc wake_all(wq: WaitQueue*) -> u64 {
        wq.lock.acquire_irq();

        var count: u64 = 0;

        while (!wq.head.is_empty()) {
            var node: ListNode* = wq.head.pop_head();
            var t: Thread*      = thread_from_wait_node(node);

            t.state = THREAD_STATE_READY;
            count   = count + 1;
        }

        wq.lock.release_irq();

        return count;
    }
}