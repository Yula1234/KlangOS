import "sync/spinlock.kl";

import "sched/thread.kl";
import "sched/sched.kl";


packed struct WaitQueue {
    head: Thread*,
    tail: Thread*,
    lock: Spinlock,

    proc init(wq: WaitQueue*) -> void {
        wq.head = cast(Thread*, 0);
        wq.tail = cast(Thread*, 0);
        
        wq.lock.init();

        return;
    }

    proc enqueue_unlocked(wq: WaitQueue*, t: Thread*) -> void {
        t.wait_next = cast(Thread*, 0);

        if (cast(u64, wq.head) == 0) {
            wq.head = t;
            wq.tail = t;
            return;
        }

        wq.tail.wait_next = t;
        wq.tail           = t;

        return;
    }

    proc dequeue_unlocked(wq: WaitQueue*) -> Thread* {
        if (cast(u64, wq.head) == 0) {
            return cast(Thread*, 0);
        }

        var t: Thread* = wq.head;

        wq.head     = t.wait_next;
        t.wait_next = cast(Thread*, 0);

        if (cast(u64, wq.head) == 0) {
            wq.tail = cast(Thread*, 0);
        }

        return t;
    }

    proc is_empty(wq: WaitQueue*) -> bool {
        wq.lock.acquire_irq();
        var empty: bool = cast(u64, wq.head) == 0;
        wq.lock.release_irq();

        return empty;
    }

    proc wait(wq: WaitQueue*) -> void {
        wq.lock.acquire_irq();

        wq.enqueue_unlocked(g_current_thread);
        g_current_thread.state = THREAD_STATE_BLOCKED;

        wq.lock.release_irq();

        thread_yield();

        return;
    }

    proc wake_one(wq: WaitQueue*) -> bool {
        wq.lock.acquire_irq();

        var t: Thread* = wq.dequeue_unlocked();

        if (cast(u64, t) != 0) {
            t.state = THREAD_STATE_READY;
            wq.lock.release_irq();
            return true;
        }

        wq.lock.release_irq();

        return false;
    }

    proc wake_all(wq: WaitQueue*) -> u64 {
        wq.lock.acquire_irq();

        var count: u64 = 0;

        while (cast(u64, wq.head) != 0) {
            var t: Thread* = wq.dequeue_unlocked();

            if (cast(u64, t) != 0) {
                t.state = THREAD_STATE_READY;
                count   = count + 1;
            }
        }

        wq.lock.release_irq();

        return count;
    }
}